#: admin.py:51
msgid "Code information"
msgstr "Información del código"

#: admin.py:62
msgid "Segments"
msgstr "Segmentos"

#: admin.py:74
msgid "Symbols"
msgstr "Símbolos"

#: admin.py:84 models.py:483
msgid "Status"
msgstr "Estado"

#: admin.py:92
msgid "System Information"
msgstr "Información del sistema"

#: admin.py:133 models.py:181
msgid "Layout"
msgstr "Disposición"

#: admin.py:144
msgid "Live preview"
msgstr "Vista previa en vivo"

#: admin.py:148
msgid ""
"Updates as you edit the placements below. Drag a summary to move it: the "
"offsets are written back into the form."
msgstr ""
"Se actualiza mientras editas las posiciones de abajo. Arrastra un resumen "
"para moverlo: los desplazamientos se escriben de vuelta en el formulario."

#: admin.py:159
msgid "Placements"
msgstr "Posiciones"

#: api.py:36
msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

#: api.py:54
msgid "Malformed JSON body."
msgstr "El cuerpo JSON está mal formado."

#: api.py:83
msgid "\"placements\" must be a list."
msgstr "\"placements\" tiene que ser una lista."

#: api.py:90
#, python-format
msgid "Placement %(number)s is not an object."
msgstr "La posición %(number)s no es un objeto."

#: api.py:100
#, python-format
msgid "Placement %(number)s: unknown code kind."
msgstr "Posición %(number)s: tipo de código desconocido."

#: api.py:106
#, python-format
msgid "Placement %(number)s: unknown anchor."
msgstr "Posición %(number)s: anclaje desconocido."

#: api.py:112
#, python-format
msgid "Placement %(number)s: unknown page selector."
msgstr "Posición %(number)s: selector de páginas desconocido."

#: api.py:126
#, python-format
msgid "Placement %(number)s: the measurements must be numbers."
msgstr "Posición %(number)s: las medidas tienen que ser números."

#: api.py:132
#, python-format
msgid "Placement %(number)s: width and height must be at least 1 pt."
msgstr "Posición %(number)s: el ancho y el alto deben ser de al menos 1 pt."

#: api.py:138
#, python-format
msgid "Placement %(number)s: opacity must be between 0 and 1."
msgstr "Posición %(number)s: la opacidad debe estar entre 0 y 1."

#: api.py:146
#, python-format
msgid ""
"Placement %(number)s: a member barcode must say which document of the "
"summary it carries."
msgstr ""
"Posición %(number)s: un código de barras de miembro tiene que indicar qué "
"documento del resumen lleva."

#: api.py:222
msgid "Stamp layout updated."
msgstr "Disposición de estampado actualizada."

#: api.py:244
msgid "The layout name is required."
msgstr "El nombre de la disposición es obligatorio."

#: api.py:254
msgid "A layout with this name already exists."
msgstr "Ya existe una disposición con este nombre."

#: api.py:277
msgid "Stamp layout created."
msgstr "Disposición de estampado creada."

#: api.py:348 views.py:694
msgid "Not sent"
msgstr "Sin enviar"

#: api.py:401
msgid "\"members\" must be a list."
msgstr "«members» tiene que ser una lista."

#: api.py:411
#, python-format
msgid "Member %(number)s is not an object."
msgstr "El miembro %(number)s no es un objeto."

#: api.py:422
#, python-format
msgid "Member %(number)s has no code."
msgstr "El miembro %(number)s no tiene código."

#: api.py:429
#, python-format
msgid "The code %(code)s is repeated in the summary."
msgstr "El código %(code)s está repetido en el resumen."

#: api.py:443
#, python-format
msgid "Member %(code)s points to a document that does not exist."
msgstr "El miembro %(code)s apunta a un documento que no existe."

#: api.py:451
#, python-format
msgid "%(code)s is not certified: it has no fingerprint to include."
msgstr "%(code)s no está certificado: no tiene huella que incluir."

#: api.py:490
msgid "Members updated. The summary needs sealing again."
msgstr "Miembros actualizados. Hay que volver a sellar el resumen."

#: api.py:546
msgid "It was already sent to the blockchain."
msgstr "Ya se envió a la cadena de bloques."

#: api.py:554
#, python-format
msgid ""
"Sealed, but the blockchain calendars did not answer (%(reason)s). The seal "
"is saved; send it later with «Send to blockchain». Run «Blockchain "
"anchoring» in the operations console to see whether this server has the "
"library and outbound access."
msgstr ""
"Sellado, pero los calendarios de la cadena de bloques no respondieron "
"(%(reason)s). El sellado está guardado; envíalo más tarde con «Enviar a la "
"cadena de bloques». Ejecuta «Anclaje en blockchain» en la consola de "
"operaciones para ver si este servidor tiene la librería y salida a internet."

#: api.py:562
#, python-format
msgid ""
"Sealed, but the OpenTimestamps library is not installed on this server "
"(%(reason)s). The seal is saved. This is fixed by installing requirements."
"txt with pip on the server, not from here — check first with «Dependencies» "
"in the operations console that the package actually reached that file."
msgstr ""
"Sellado, pero la librería OpenTimestamps no está instalada en este servidor "
"(%(reason)s). El sellado está guardado. Esto se arregla instalando "
"requirements.txt con pip en el servidor, no desde aquí: comprueba antes con "
"«Dependencias», en la consola de operaciones, que el paquete llegó de verdad "
"a ese fichero."

#: api.py:571
#, python-format
msgid ""
"Sealed, but sending to the blockchain failed: %(kind)s: %(reason)s. The seal "
"is saved; send it later with «Send to blockchain». Run «Blockchain "
"anchoring» in the operations console for a full diagnosis."
msgstr ""
"Sellado, pero el envío a la cadena de bloques falló: %(kind)s: %(reason)s. "
"El sellado está guardado; envíalo más tarde con «Enviar a la cadena de "
"bloques». Ejecuta «Anclaje en blockchain» en la consola de operaciones para "
"un diagnóstico completo."

#: api.py:578
msgid ""
"Sealed and sent to the blockchain. The proof is born pending: it matures "
"into a Bitcoin block within a few hours, on its own."
msgstr ""
"Sellado y enviado a la cadena de bloques. La prueba nace pendiente: madura "
"hasta un bloque de Bitcoin en unas horas, ella sola."

#: api.py:615
msgid "Summary sealed."
msgstr "Resumen sellado."

#: api.py:650
msgid "Seal the summary before sending it."
msgstr "Sella el resumen antes de enviarlo."

#: api.py:658
msgid ""
"Sent to the blockchain. The proof is born pending: it matures into a Bitcoin "
"block within a few hours, on its own."
msgstr ""
"Enviado a la cadena de bloques. La prueba nace pendiente: madura hasta un "
"bloque de Bitcoin en unas horas, ella sola."

#: api.py:707
msgid ""
"Seal the summary before issuing its document: it carries the master hash "
"inside."
msgstr ""
"Sella el resumen antes de emitir su documento: lleva el master hash dentro."

#: api.py:719
msgid ""
"Upload the summary PDF without codes: there is no original stored yet to "
"stamp over."
msgstr ""
"Sube el PDF del resumen sin códigos: todavía no hay un original guardado "
"sobre el que estampar."

#: api.py:730
msgid "Choose a stamp layout: it decides where each code goes on the page."
msgstr ""
"Elige una disposición de estampado: es la que decide dónde va cada código en "
"la página."

#: api.py:753
#, python-format
msgid "The summary document could not be issued: %(error)s"
msgstr "No se pudo emitir el documento del resumen: %(error)s"

#: api.py:762
msgid ""
"Summary document issued. Its QR points at the anchor page, which updates "
"itself: there is nothing to reissue when the Bitcoin block arrives."
msgstr ""
"Documento del resumen emitido. Su QR apunta a la página de anclaje, que se "
"actualiza sola: no hay nada que reemitir cuando llegue el bloque de Bitcoin."

#: apps.py:8
msgid "Code generation and document certification"
msgstr "Generación de códigos y certificación documental"

#: forms.py:23
msgid "Public verification URL (requires certifying a document)"
msgstr "URL pública de verificación (requiere certificar un documento)"

#: forms.py:25
msgid "The generated code itself"
msgstr "El propio código generado"

#: forms.py:26
msgid "A custom URL or text"
msgstr "Una URL o un texto personalizado"

