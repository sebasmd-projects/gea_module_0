msgstr "Anclajes de certificación"

#: preview.py:26
msgid "Page size"
msgstr "Tamaño de página"

#: preview.py:27
msgid "Drag a box to move it; the offsets update as you go."
msgstr ""
"Arrastra un resumen para moverla; los desplazamientos se actualizan sobre la "
"marcha."

#: preview.py:28
msgid "Rendering the document…"
msgstr "Dibujando el documento…"

#: preview.py:30
msgid "The document could not be rendered; the placements still work."
msgstr "No se pudo dibujar el documento; las posiciones siguen funcionando."

#: preview.py:32
msgid "No placements yet. Add one to see it here."
msgstr "Todavía no hay posiciones. Añade una para verla aquí."

#: preview.py:33
msgid "This placement falls outside the page."
msgstr "Esta posición queda fuera de la página."

#: preview.py:35
msgid ""
"Drag a corner to resize keeping the proportion, or an edge to change only "
"the width or the height."
msgstr ""
"Arrastra una esquina para redimensionar conservando la proporción, o un lado "
"para cambiar solo el ancho o el alto."

#: preview.py:39
#, python-format
msgid ""
"The symbol keeps its proportion, so it uses %(w)s x %(h)s pt of the %(bw)s x "
"%(bh)s pt box."
msgstr ""
"El símbolo conserva su proporción, así que ocupa %(w)s x %(h)s pt del "
"resumen de %(bw)s x %(bh)s pt."

#: preview.py:42
msgid "The symbol fills the box exactly."
msgstr "El símbolo llena el resumen exactamente."

#: preview.py:43
msgid "Sample characters"
msgstr "Caracteres de muestra"

#: preview.py:45
msgid ""
"Number of characters in the sample barcode. The more characters, the wider "
"the symbol gets."
msgstr ""
"Número de caracteres del código de barras de muestra. Cuantos más "
"caracteres, más ancho sale el símbolo."

#: services/anchoring.py:65 services/anchoring.py:100
msgid "Seal the summary before anchoring it."
msgstr "Sella el resumen antes de anclarlo."

#: services/anchoring.py:81
#, python-format
msgid "Policy %(policy)s"
msgstr "Política %(policy)s"

#: services/anchoring.py:111
msgid "Waiting for inclusion in a Bitcoin block."
msgstr "Esperando a entrar en un bloque de Bitcoin."

#: services/anchoring.py:284
msgid "This anchor type cannot be verified by the platform yet."
msgstr "La plataforma todavía no puede verificar este tipo de anclaje."

#: services/anchoring.py:289
msgid ""
"The anchor is valid, but it covers an earlier master hash: the summary was "
"re-sealed after being anchored."
msgstr ""
"El anclaje es válido, pero cubre un master hash anterior: el resumen se "
"volvió a sellar después de anclarlo."

#: services/certification.py:195
msgid "Upload the original document (without codes) first."
msgstr "Sube primero el documento original (sin códigos)."

#: services/certification.py:212
msgid "The uploaded file is not a readable PDF."
msgstr "El archivo subido no es un PDF legible."

#: services/certification.py:378
#, python-format
msgid "Automatic certification of document %(pk)s"
msgstr "Certificación automática del documento %(pk)s"

#: services/codes.py:77
msgid "The barcode text cannot be empty."
msgstr "El texto del código de barras no puede estar vacío."

#: services/codes.py:83
msgid ""
"URLs and resource schemes (\":\", \"://\") cannot be encoded in a barcode. "
"Use the QR code for links."
msgstr ""
"Las URLs y los esquemas de recurso (\":\", \"://\") no se pueden codificar "
"en un código de barras. Usa el código QR para los enlaces."

#: services/codes.py:91
#, python-format
msgid ""
"The sequence \"%(token)s\" is not allowed in a barcode. Use the QR code "
"instead."
msgstr ""
"La secuencia \"%(token)s\" no está permitida en un código de barras. Usa el "
"código QR en su lugar."

#: services/codes.py:98
#, python-format
msgid ""
"These characters are not allowed in a barcode: %(chars)s. Use the QR code "
"instead."
msgstr ""
"Estos caracteres no están permitidos en un código de barras: %(chars)s. Usa "
"el código QR en su lugar."

#: services/codes.py:104
msgid ""
"Only letters, digits, spaces and the symbols . _ - are allowed in a barcode."
msgstr ""
"En un código de barras solo se admiten letras, dígitos, espacios y los "
"símbolos . _ - ."

#: services/codes.py:110
#, python-format
msgid ""
"The barcode text is too long (%(length)s characters). The maximum is "
"%(maximum)s."
msgstr ""
"El texto del código de barras es demasiado largo (%(length)s caracteres). El "
"máximo es %(maximum)s."

#: services/codes.py:124
#, python-format
msgid ""
"The barcode has %(length)s characters; above %(maximum)s the symbol becomes "
"very wide and harder to scan when printed."
msgstr ""
"El código de barras tiene %(length)s caracteres; por encima de %(maximum)s "
"el símbolo queda muy ancho y cuesta más escanearlo impreso."

#: services/codes.py:157
msgid "Could not generate a unique code. Try again."
msgstr "No se pudo generar un código único. Inténtalo de nuevo."

#: services/master.py:67
msgid "The summary has no member documents."
msgstr "El resumen no tiene documentos miembros."

#: services/master.py:78
#, python-format
msgid "%(code)s is not certified yet."
msgstr "%(code)s todavía no está certificado."

#: services/master.py:86
#, python-format
msgid "%(code)s has no certified fingerprint."
msgstr "%(code)s no tiene huella certificada."

#: services/master.py:190
msgid "The summary has not been sealed yet."
msgstr "El resumen todavía no se ha sellado."

#: services/master.py:210
msgid ""
"The stored hash does not match the stored payload: the record is corrupt."
msgstr ""
"El hash guardado no corresponde al payload guardado: el registro está "
"corrupto."

#: services/master.py:215
msgid ""
"The summary changed after it was sealed: its members no longer match the "
"sealed payload."
msgstr ""
"El resumen cambió después de sellarse: sus miembros ya no coinciden con el "
"payload sellado."

#: services/master.py:219
msgid "The master hash is consistent."
msgstr "El master hash es consistente."

#: services/ots.py:114 services/tsa.py:93
msgid "The hash is not valid hexadecimal."
msgstr "El hash no es hexadecimal válido."

#: services/ots.py:117 services/tsa.py:96
msgid "Only SHA-256 digests are supported."
msgstr "Solo se admiten digests SHA-256."

#: services/ots.py:135
msgid "No OpenTimestamps calendar could be reached."
msgstr "No se pudo contactar con ningún calendario de OpenTimestamps."

#: services/ots.py:176
msgid "There is no OpenTimestamps proof stored."
msgstr "No hay ninguna prueba de OpenTimestamps almacenada."

#: services/ots.py:182 services/ots.py:235
msgid "The proof file could not be read."
msgstr "No se pudo leer el archivo de prueba."

#: services/ots.py:187
msgid "The proof covers a different hash: it does not attest this summary."
msgstr "La prueba cubre un hash distinto: no acredita este resumen."

#: services/ots.py:209
#, python-format
msgid "Committed to Bitcoin block %(block)s."
msgstr "Comprometido en el bloque de Bitcoin %(block)s."

#: services/ots.py:214
msgid ""
"The commitment is made; waiting for it to be included in a Bitcoin block "
"(usually a few hours)."
msgstr ""
"El compromiso ya está hecho; falta que entre en un bloque de Bitcoin "
"(normalmente unas horas)."

#: services/samples.py:141
msgid "Sample QR pointing to the platform."
msgstr "QR de muestra que apunta a la plataforma."

#: services/samples.py:165
#, python-format
msgid "Sample payload of %(count)s characters."
msgstr "Carga de muestra de %(count)s caracteres."

#: services/samples.py:169
msgid "Real code for this document."
msgstr "Código real de este documento."

#: services/summary.py:52 services/summary.py:206
msgid "Seal the summary before issuing its document."
msgstr "Sella el resumen antes de emitir su documento."

#: services/tsa.py:65
msgid "The timestamp token has no readable TSTInfo."
msgstr "El token de sello de tiempo no tiene un TSTInfo legible."

#: services/tsa.py:132
msgid "The timestamp authority returned an unreadable response."
msgstr "La autoridad de sellado devolvió una respuesta ilegible."

#: services/tsa.py:149
#, python-format
msgid ""
"The timestamp authority refused the request (status %(status)s). %(reason)s"
msgstr ""
"La autoridad de sellado rechazó la petición (estado %(status)s). %(reason)s"

#: services/tsa.py:163
msgid "The timestamp token could not be parsed."
msgstr "No se pudo interpretar el token de sello de tiempo."

#: services/tsa.py:172
msgid "The timestamp covers a different hash than the one sent."
msgstr "El sello cubre un hash distinto del que se envió."

#: services/tsa.py:207
msgid "No timestamp authority is configured (CERTIFICATION_TSA_URL)."
msgstr ""
"No hay ninguna autoridad de sellado configurada (CERTIFICATION_TSA_URL)."

#: services/tsa.py:237
#, python-format
msgid "Could not reach the timestamp authority: %(error)s"
msgstr "No se pudo contactar con la autoridad de sellado: %(error)s"

#: services/tsa.py:264
msgid "There is no timestamp token stored."
msgstr "No hay ningún token de sello de tiempo almacenado."

#: services/tsa.py:271
msgid "The stored token could not be parsed."
msgstr "No se pudo interpretar el token almacenado."

#: services/tsa.py:282
msgid "The token covers a different hash: it does not attest this summary."
msgstr "El token cubre un hash distinto: no acredita este resumen."

#: services/tsa.py:289
msgid "The token attests this hash existed at the time it states."
msgstr "El token acredita que este hash existía en la hora que indica."

#: services/usb_readiness.py:94
msgid "not certified"
msgstr "sin certificar"

#: services/usb_readiness.py:98
msgid "no public copy"
msgstr "sin copia pública"

#: services/usb_readiness.py:101
msgid "its public copy is not on disk"
msgstr "su copia pública no está en disco"

#: services/usb_readiness.py:124
msgid "It has no master hash yet: seal it first."
msgstr "Todavía no tiene master hash: séllalo primero."

#: services/usb_readiness.py:127
msgid ""
"The stored payload does not produce the stored hash. Do not export this: "
"something rewrote one of the two."
msgstr ""
"El payload guardado no produce el hash guardado. No exportes esto: algo "
"reescribió uno de los dos."

#: services/usb_readiness.py:132
msgid ""
"The sealed payload no longer describes the current members. Seal it again so "
"the hash covers what the summary holds today."
msgstr ""
"El payload sellado ya no describe a los miembros de ahora. Vuelve a sellarlo "
"para que el hash cubra lo que el resumen lleva hoy."

#: services/usb_readiness.py:150
msgid ""
"There is no certified PDF for the summary. Issue it: it is the paper that "
"goes on the device."
msgstr ""
"No hay PDF certificado del resumen. Emítelo: es el papel que va en el "
"dispositivo."

#: services/usb_readiness.py:155
msgid ""
"The summary PDF is certified, but its public copy is not on disk. Issue it "
"again: what is not on disk cannot be copied."
msgstr ""
"El PDF del resumen está certificado, pero su copia pública no está en disco. "
"Vuelve a emitirlo: lo que no está en disco no se puede copiar."

#: services/usb_readiness.py:176
msgid ""
"The OpenTimestamps proof is still pending: there is a commitment but no "
"block yet. It matures on its own — the scheduled task upgrades it every 15 "
"minutes, and it usually takes a few hours."
msgstr ""
"La prueba de OpenTimestamps sigue pendiente: hay compromiso, todavía no hay "
"bloque. Madura sola — la tarea programada la actualiza cada 15 minutos, y "
"suele tardar unas horas."

#: services/usb_readiness.py:182
msgid ""
"It has never been sent to OpenTimestamps. Send it from the anchoring page."
msgstr ""
"Nunca se ha enviado a OpenTimestamps. Mándalo desde la página de anclaje."

#: services/usb_readiness.py:193
#, python-format
msgid "%(anchors)s failed anchor(s), and: %(members)s"
msgstr "%(anchors)s anclaje(s) fallido(s), y: %(members)s"

#: services/usb_readiness.py:196
#, python-format
msgid "%(anchors)s failed anchor(s)."
msgstr "%(anchors)s anclaje(s) fallido(s)."

#: services/usb_readiness.py:206
msgid "Active"
msgstr "Activo"

#: services/usb_readiness.py:209
msgid "The summary is withdrawn. A withdrawn summary is not handed out."
msgstr "El resumen está retirado. Un resumen retirado no se reparte."

#: services/usb_readiness.py:215
msgid "Sealed, and the seal still matches"
msgstr "Sellado, y el sello sigue cuadrando"

#: services/usb_readiness.py:221
msgid "Summary document issued"
msgstr "Documento del resumen emitido"

#: services/usb_readiness.py:227
msgid "Confirmed on the blockchain"
msgstr "Confirmado en la cadena de bloques"

#: services/usb_readiness.py:233
msgid "No errors"
msgstr "Sin errores"

#: views.py:87
msgid "The code could not be generated. Check the logs for details."
msgstr "No se pudo generar el código. Revisa los registros para más detalle."

#: views.py:160
msgid "Select at least one segment to build the code."
msgstr "Selecciona al menos un segmento para construir el código."

#: views.py:223
#, python-format
msgid "Some placements did not match any page: %(items)s"
msgstr "Algunas posiciones no coincidieron con ninguna página: %(items)s"

#: views.py:229
#, python-format
msgid "Document certified. Public code: %(code)s"
msgstr "Documento certificado. Código público: %(code)s"

#: views.py:402
#, python-format
msgid "This summary cannot be exported yet. %(reasons)s"
msgstr "Este resumen todavía no se puede exportar. %(reasons)s"

#: views.py:567
msgid "Stamp layout saved."
msgstr "Disposición de estampado guardada."

#: views.py:649
msgid "Summary created. Now add the certificates it gathers."
msgstr "Resumen creado. Ahora añade los certificados que contiene."
