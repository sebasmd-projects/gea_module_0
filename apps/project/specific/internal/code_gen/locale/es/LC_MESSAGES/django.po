msgid "Reference"
msgstr "Referencia"

#: forms.py:48
msgid "e.g. AEGIS Special Edition"
msgstr "p. ej. AEGIS Special Edition"

#: forms.py:54 models.py:105 models.py:325
msgid "Description"
msgstr "Descripción"

#: forms.py:60
msgid "Internal notes about this code"
msgstr "Notas internas sobre este código"

#: forms.py:66
msgid "Custom text"
msgstr "Texto personalizado"

#: forms.py:72
msgid "Free text added to the code"
msgstr "Texto libre que se añade al código"

#: forms.py:81
msgid "NIT"
msgstr "NIT"

#: forms.py:84
msgid "Adds the tax ID of the firm at the beginning."
msgstr "Añade el NIT de la firma al principio."

#: forms.py:88
msgid "Certificate initials + autonomous sequence"
msgstr "Iniciales del certificado + secuencia autónoma"

#: forms.py:92
msgid "Non-consecutive and non-repeating sequence, reserved by the platform."
msgstr "Secuencia no consecutiva y no repetida, reservada por la plataforma."

#: forms.py:98
msgid "Initials"
msgstr "Iniciales"

#: forms.py:104
msgid "Derived from the reference if left empty"
msgstr "Se deriva de la referencia si se deja vacío"

#: forms.py:110
msgid "Document hash"
msgstr "Hash del documento"

#: forms.py:113
msgid ""
"Requires uploading the document. The code carries the base64 fingerprint of "
"the original file."
msgstr ""
"Requiere subir el documento. El código lleva la huella en base64 del archivo "
"original."

#: forms.py:119
msgid "Hash characters"
msgstr "Caracteres del hash"

#: forms.py:128
msgid "Date (DDMMYYYY)"
msgstr "Fecha (DDMMAAAA)"

#: forms.py:134 models.py:359
msgid "Unique random code"
msgstr "Código único aleatorio"

#: forms.py:140
msgid "Random code length"
msgstr "Longitud del código aleatorio"

#: forms.py:152
msgid "Generate barcode (Code128)"
msgstr "Generar código de barras (Code128)"

#: forms.py:156
msgid ""
"Only letters, digits, spaces and . _ - are allowed. URLs cannot be encoded "
"in a barcode."
msgstr ""
"Solo se admiten letras, dígitos, espacios y los símbolos . _ - . Las URLs no "
"se pueden codificar en un código de barras."

#: forms.py:162
msgid "Generate QR code"
msgstr "Generar código QR"

#: forms.py:168
msgid "QR content"
msgstr "Contenido del QR"

#: forms.py:176
msgid "Custom QR content"
msgstr "Contenido personalizado del QR"

#: forms.py:191
msgid "Original document (without codes)"
msgstr "Documento original (sin códigos)"

#: forms.py:205
msgid "Certify this document"
msgstr "Certificar este documento"

#: forms.py:208
msgid ""
"Embeds the codes in the PDF, computes its fingerprints and issues the "
"distributable digital copy."
msgstr ""
"Incrusta los códigos en el PDF, calcula sus huellas y emite la copia digital "
"distribuible."

#: forms.py:214
msgid "Document title"
msgstr "Título del documento"

#: forms.py:221
msgid "Certificate type"
msgstr "Tipo de Certificado"

#: forms.py:227
msgid "Stamp layout"
msgstr "Disposición de los códigos"

#: forms.py:230
msgid "Default layout"
msgstr "Disposición por defecto"

#: forms.py:235
msgid "Issued at"
msgstr "Emitido en"

#: forms.py:243
msgid "Expires at"
msgstr "Vence en"

#: forms.py:264
#, python-format
msgid "Accepted formats: %(formats)s."
msgstr "Formatos aceptados: %(formats)s."

#: forms.py:271
msgid ""
"What kind of document this is. It is shown on the public verification page, "
"under the document title. Use \"Asset Certificate (AEGIS)\" for the "
"certificates of a summary of assets, and \"Generic Document\" for anything "
"else."
msgstr ""
"Qué clase de documento es. Aparece en la página pública de verificación, "
"debajo del título. Usa «Certificado de activo (AEGIS)» para los certificados "
"de un resumen de activos, y «Documento genérico» para todo lo demás."

#: forms.py:290 services/certification.py:203
#, python-format
msgid "Only these formats can be certified: %(formats)s."
msgstr "Solo se pueden certificar estos formatos: %(formats)s."

#: forms.py:296
#, python-format
msgid "The file is too large. The maximum is %(size)s MB."
msgstr "El archivo es demasiado grande. El máximo son %(size)s MB."

#: forms.py:310
msgid "Upload the document to include its hash in the code."
msgstr "Sube el documento para incluir su hash en el código."

#: forms.py:317
msgid "Upload the document you want to certify."
msgstr "Sube el documento que quieres certificar."

#: forms.py:328
msgid "Select at least one symbol to generate: barcode or QR."
msgstr "Selecciona al menos un símbolo a generar: código de barras o QR."

#: forms.py:337
msgid "Enter the content for the QR code."
msgstr "Introduce el contenido del código QR."

#: forms.py:344
msgid ""
"The public verification URL only exists once the document is certified. "
"Certify the document or choose another QR content."
msgstr ""
"La URL pública de verificación solo existe una vez certificado el documento. "
"Certifica el documento o elige otro contenido para el QR."

#: forms.py:470
msgid "— none —"
msgstr "— ninguno —"

#: forms.py:476
msgid "Search asset…"
msgstr "Buscar activo…"

#: forms.py:477
msgid "No asset matches."
msgstr "Ningún activo coincide."

#: forms.py:481
msgid ""
"How this summary is identified internally, e.g. \"AEGIS summary - Zimbabwe "
"gold micro-ingots\"."
msgstr ""
"Cómo se identifica este resumen internamente, p. ej. «Resumen AEGIS - "
"microlingotes de oro de Zimbabue»."

#: forms.py:485
msgid ""
"Optional. Readable name printed on the summary. The binding is made through "
"the asset UUID, never through this text."
msgstr ""
"Opcional. Nombre legible que se imprime en el resumen. El vínculo se hace "
"por el UUID del activo, nunca por este texto."

#: forms.py:489
msgid "Issue date printed on the summary document."
msgstr "Fecha de emisión que se imprime en el documento resumen."

