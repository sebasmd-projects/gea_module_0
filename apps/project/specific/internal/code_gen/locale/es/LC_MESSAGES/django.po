#: .\apps\project\specific\internal\code_gen\services\certification.py:194
msgid "Upload the original document (without codes) first."
msgstr "Sube primero el documento original (sin códigos)."

#: .\apps\project\specific\internal\code_gen\services\certification.py:211
msgid "The uploaded file is not a readable PDF."
msgstr "El archivo subido no es un PDF legible."

#: .\apps\project\specific\internal\code_gen\services\certification.py:367
#, python-format
msgid "Automatic certification of document %(pk)s"
msgstr "Certificación automática del documento %(pk)s"

#: .\apps\project\specific\internal\code_gen\services\codes.py:77
msgid "The barcode text cannot be empty."
msgstr "El texto del código de barras no puede estar vacío."

#: .\apps\project\specific\internal\code_gen\services\codes.py:83
msgid ""
"URLs and resource schemes (\":\", \"://\") cannot be encoded in a barcode. "
"Use the QR code for links."
msgstr ""
"Las URLs y los esquemas de recurso (\":\", \"://\") no se pueden codificar "
"en un código de barras. Usa el código QR para los enlaces."

#: .\apps\project\specific\internal\code_gen\services\codes.py:91
#, python-format
msgid ""
"The sequence \"%(token)s\" is not allowed in a barcode. Use the QR code "
"instead."
msgstr ""
"La secuencia \"%(token)s\" no está permitida en un código de barras. Usa el "
"código QR en su lugar."

#: .\apps\project\specific\internal\code_gen\services\codes.py:98
#, python-format
msgid ""
"These characters are not allowed in a barcode: %(chars)s. Use the QR code "
"instead."
msgstr ""
"Estos caracteres no están permitidos en un código de barras: %(chars)s. Usa "
"el código QR en su lugar."

#: .\apps\project\specific\internal\code_gen\services\codes.py:104
msgid ""
"Only letters, digits, spaces and the symbols . _ - are allowed in a barcode."
msgstr ""
"En un código de barras solo se admiten letras, dígitos, espacios y los "
"símbolos . _ - ."

#: .\apps\project\specific\internal\code_gen\services\codes.py:110
#, python-format
msgid ""
"The barcode text is too long (%(length)s characters). The maximum is "
"%(maximum)s."
msgstr ""
"El texto del código de barras es demasiado largo (%(length)s caracteres). El "
"máximo es %(maximum)s."

#: .\apps\project\specific\internal\code_gen\services\codes.py:124
#, python-format
msgid ""
"The barcode has %(length)s characters; above %(maximum)s the symbol becomes "
"very wide and harder to scan when printed."
msgstr ""
"El código de barras tiene %(length)s caracteres; por encima de %(maximum)s "
"el símbolo queda muy ancho y cuesta más escanearlo impreso."

#: .\apps\project\specific\internal\code_gen\services\codes.py:157
msgid "Could not generate a unique code. Try again."
msgstr "No se pudo generar un código único. Inténtalo de nuevo."

#: .\apps\project\specific\internal\code_gen\views.py:62
msgid "The code could not be generated. Check the logs for details."
msgstr "No se pudo generar el código. Revisa los registros para más detalle."

#: .\apps\project\specific\internal\code_gen\views.py:134
msgid "Select at least one segment to build the code."
msgstr "Selecciona al menos un segmento para construir el código."

