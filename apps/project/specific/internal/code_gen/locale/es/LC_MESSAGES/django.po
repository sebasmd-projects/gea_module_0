msgstr "Token de sello de tiempo en DER, o el archivo de prueba .ots."

#: models.py:498
msgid "Provider"
msgstr "Proveedor"

#: models.py:505
msgid "Attested time"
msgstr "Hora acreditada"

#: models.py:508
msgid "The time the anchor itself attests, not our clock."
msgstr "La hora que acredita el propio anclaje, no nuestro reloj."

#: models.py:512
msgid "Serial"
msgstr "Número de serie"

#: models.py:519
msgid "Detail"
msgstr "Detalle"

