msgstr "Contenido personalizado del QR"

#: .\apps\project\specific\internal\code_gen\forms.py:190
msgid "Original document (without codes)"
msgstr "Documento original (sin códigos)"

#: .\apps\project\specific\internal\code_gen\forms.py:204
msgid "Certify this document"
msgstr "Certificar este documento"

#: .\apps\project\specific\internal\code_gen\forms.py:207
msgid ""
"Embeds the codes in the PDF, computes its fingerprints and issues the "
"distributable digital copy."
msgstr ""
"Incrusta los códigos en el PDF, calcula sus huellas y emite la copia digital "
"distribuible."

#: .\apps\project\specific\internal\code_gen\forms.py:213
msgid "Document title"
msgstr "Título del documento"

#: .\apps\project\specific\internal\code_gen\forms.py:220
