msgstr "Generar código de barras (Code128)"

#: .\apps\project\specific\internal\code_gen\forms.py:155
msgid ""
"Only letters, digits, spaces and . _ - are allowed. URLs cannot be encoded "
"in a barcode."
msgstr ""
"Solo se admiten letras, dígitos, espacios y los símbolos . _ - . Las URLs no "
"se pueden codificar en un código de barras."

#: .\apps\project\specific\internal\code_gen\forms.py:161
