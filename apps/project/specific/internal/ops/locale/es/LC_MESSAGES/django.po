#: admin.py:91 models.py:50
msgid "Status"
msgstr "Estado"

#: admin.py:155
msgid "Operations console"
msgstr "Consola de operaciones"

#: admin.py:196 registry.py:1581
msgid "Test summary"
msgstr "Resumen de pruebas"

#: admin.py:254
#, python-format
msgid "Type \"%(name)s\" to confirm before running it."
msgstr "Escriba \"%(name)s\" para confirmar antes de ejecutarlo."

#: admin.py:279
msgid "That command is not allowed."
msgstr "Ese comando no está permitido."

#: admin.py:299
#, python-format
msgid "%(title)s finished in %(seconds)s s."
msgstr "%(title)s terminó en %(seconds)s s."

#: admin.py:305
#, python-format
msgid ""
"%(title)s was cut off after %(seconds)s s. The output below is partial, and "
"the command may have kept going."
msgstr ""
"%(title)s se cortó a los %(seconds)s s. La salida de abajo está incompleta, "
"y el comando puede haber seguido ejecutándose."

#: admin.py:312
#, python-format
msgid "%(title)s failed with exit code %(code)s."
msgstr "%(title)s falló con código de salida %(code)s."

#: apps.py:11
msgid "Operations"
msgstr "Operaciones"

#: models.py:24
msgid "Finished"
msgstr "Terminado"

#: models.py:25
msgid "Failed"
msgstr "Fallido"

#: models.py:26
msgid "Cut off by timeout"
msgstr "Cortado por tiempo límite"

#: models.py:27
msgid "Refused"
msgstr "Rechazado"

#: models.py:30
msgid "Command"
msgstr "Comando"

#: models.py:36
msgid "Arguments"
msgstr "Argumentos"

#: models.py:39
msgid "The values as they were filled in the form."
msgstr "Los valores tal como se rellenaron en el formulario."

#: models.py:43
msgid "Command line"
msgstr "Línea de comando"

#: models.py:46
msgid "What was actually run, argument by argument."
msgstr "Lo que se ejecutó realmente, argumento por argumento."

#: models.py:57
msgid "Exit code"
msgstr "Código de salida"

#: models.py:63
msgid "Duration (s)"
msgstr "Duración (s)"

#: models.py:68
msgid "Output"
msgstr "Salida"

#: models.py:77
msgid "Run by"
msgstr "Ejecutado por"

#: models.py:85
msgid "Client IP"
msgstr "IP del cliente"

#: models.py:99
msgid "Command run"
msgstr "Ejecución de comando"

#: models.py:100
msgid "Command runs"
msgstr "Ejecuciones de comandos"

#: registry.py:111
msgid "Always"
msgstr "Siempre"

#: registry.py:112
msgid "Development only"
msgstr "Solo en desarrollo"

#: registry.py:125
msgid ""
"Destroys the audit trail the certification relies on. Purging by retention "
"policy is a written procedure, not a button."
msgstr ""
"Destruye el rastro de auditoría en el que se apoya la certificación. Purgar "
"por política de retención es un procedimiento escrito, no un botón."

#: registry.py:128
msgid "Destroys the record of access attempts."
msgstr "Destruye el registro de intentos de acceso."

#: registry.py:129
msgid "Destroys the record of failed logins."
msgstr "Destruye el registro de accesos fallidos."

#: registry.py:132
msgid "Arbitrary code execution: it voids the whole allowlist."
msgstr "Ejecución de código arbitrario: deja sin efecto toda la lista blanca."

#: registry.py:133
msgid "Arbitrary SQL: it voids the whole allowlist."
msgstr "SQL arbitrario: deja sin efecto toda la lista blanca."

#: registry.py:135
msgid ""
"Prints SECRET_KEY, the database password and FIELD_ENCRYPTION_KEY — and the "
"output is stored in CommandRunModel."
msgstr ""
"Imprime SECRET_KEY, la contraseña de la base de datos y FIELD_ENCRYPTION_KEY"
" — y la salida se guarda en CommandRunModel."

#: registry.py:139
msgid "Prints a private key, which would end up written in a table."
msgstr "Imprime una clave privada, que acabaría escrita en una tabla."

#: registry.py:142
msgid "Prints the PII encryption key, which would end up written in a table."
msgstr ""
"Imprime la clave de cifrado de la PII, que acabaría escrita en una tabla."

#: registry.py:146
msgid "Empties the entire database."
msgstr "Vacía la base de datos entera."

#: registry.py:147
msgid "Prints the SQL that empties the entire database."
msgstr "Imprime el SQL que vacía la base de datos entera."

#: registry.py:149
msgid "Would dump every record into CommandRunModel, encrypted PII included."
msgstr ""
"Volcaría todos los registros en CommandRunModel, incluida la PII cifrada."

#: registry.py:152
msgid "Injects arbitrary records."
msgstr "Inyecta registros arbitrarios."

#: registry.py:154
msgid ""
"Decrypts a backup and writes the personal data, in the clear, onto the "
"server filesystem. That is the whole point of encrypting the backup in the "
"first place, so it cannot be one click away: it needs the passphrase and a "
"shell, and it should leave someone accountable."
msgstr ""
"Descifra un respaldo y escribe los datos personales, en claro, en el disco "
"del servidor. Eso es justo lo que se evita cifrando el respaldo, así que no "
"puede estar a un clic: necesita la contraseña y un terminal, y tiene que "
"dejar a alguien como responsable."

#: registry.py:159
msgid "Bulk data injection from a web page."
msgstr "Inyección masiva de datos desde una página web."

#: registry.py:160
msgid "Bulk data extraction into the run history."
msgstr "Extracción masiva de datos al historial de ejecuciones."

#: registry.py:161
msgid "Deletes migration files across the repository."
msgstr "Borra ficheros de migración de todo el repositorio."

#: registry.py:162
msgid "Renames migration files across the repository."
msgstr "Renombra ficheros de migración de todo el repositorio."

#: registry.py:163
msgid "Cascades into deleting permissions."
msgstr "Arrastra el borrado de permisos."

#: registry.py:166
msgid "Creates credentials from a web page."
msgstr "Crea credenciales desde una página web."

#: registry.py:168
msgid "Changes credentials, and needs stdin, which here is DEVNULL."
msgstr "Cambia credenciales, y necesita stdin, que aquí es DEVNULL."

#: registry.py:170
msgid "Mints second-factor backup tokens for a user."
msgstr "Emite códigos de respaldo del segundo factor de un usuario."

#: registry.py:172
msgid ""
"Would strip the second factor from a user, from a page that requires a "
"second factor to open."
msgstr ""
"Le quitaría el segundo factor a un usuario, desde una página que exige un "
"segundo factor para abrirse."

#: registry.py:177
msgid "There is already a server running."
msgstr "Ya hay un servidor corriendo."

#: registry.py:178
msgid "Starts a throwaway server with fixture data."
msgstr "Levanta un servidor de usar y tirar con datos de ejemplo."

#: registry.py:179
msgid "Creates a new project; meaningless here."
msgstr "Crea un proyecto nuevo; aquí no significa nada."

#: registry.py:180
msgid "This project publishes no sitemap."
msgstr "Este proyecto no publica ningún sitemap."

#: registry.py:184
msgid ""
"Rewrites the audit table wholesale. It is a one-off upgrade step to run with"
" a backup in hand, not a button on a panel."
msgstr ""
"Reescribe la tabla de auditoría entera. Es un paso de actualización que se "
"hace una vez y con un respaldo a mano, no un botón de un panel."

#: registry.py:202
msgid ""
"Superseded by start_app, which sets the dotted name, the urls.py and the "
"locale folder this project needs."
msgstr ""
"Lo sustituye start_app, que fija el nombre con ruta completa, el urls.py y "
"la carpeta locale que este proyecto necesita."

#: registry.py:206
msgid ""
"This project caches in Redis, or in memory when there is none. There is no "
"cache table to create."
msgstr ""
"Este proyecto cachea en Redis, o en memoria cuando no lo hay. No hay ninguna"
" tabla de caché que crear."

#: registry.py:210
msgid ""
"A warm-up helper for django-compressor. Precompiling the bundles with "
"compress already covers what a deploy needs."
msgstr ""
"Es un auxiliar de calentamiento de django-compressor. Precompilar los "
"paquetes con compress ya cubre lo que hace falta en un despliegue."

#: registry.py:214
msgid ""
"Migration surgery belongs in an editor with the diff in front of you, and "
"the result goes through git."
msgstr ""
"La cirugía de migraciones se hace en un editor con el diff delante, y el "
"resultado pasa por git."

#: registry.py:217
msgid "Same as squashing: it rewrites source code."
msgstr "Lo mismo que agrupar migraciones: reescribe código fuente."

#: registry.py:219
msgid ""
"Covered by the two entries that are here: unlocking an address and unlocking"
" a person."
msgstr ""
"Lo cubren las dos entradas que sí están: desbloquear una dirección y "
"desbloquear a una persona."

#: registry.py:230
msgid "Read only — only reports, changes nothing"
msgstr "Solo lectura — solo informa, no cambia nada"

#: registry.py:231
msgid "Writes — changes data or files"
msgstr "Escribe — cambia datos o archivos"

#: registry.py:232
msgid "Dangerous — hard to undo, confirm before running"
msgstr "Peligroso — difícil de deshacer, confirme antes de ejecutar"

#: registry.py:264
msgid "Deploy"
msgstr "Despliegue"

#: registry.py:265
msgid "Diagnostics"
msgstr "Diagnóstico"

#: registry.py:266
msgid "Certification"
msgstr "Certificación"

#: registry.py:267 registry.py:719
msgid "Scheduled tasks"
msgstr "Tareas programadas"

#: registry.py:268
msgid "Access and blocks"
msgstr "Acceso y bloqueos"

#: registry.py:269
msgid "Maintenance"
msgstr "Mantenimiento"

#: registry.py:405
msgid "Working tree state"
msgstr "Estado del árbol de trabajo"

#: registry.py:406
msgid ""
"Shows which branch is deployed and whether anything was edited on the "
"server."
msgstr "Enseña qué rama está desplegada y si se editó algo en el servidor."

#: registry.py:409
msgid ""
"The question to answer before pulling. A file edited directly on the server "
"stops the pull, and finding that out from the error message is the slow way."
" It also says how many commits behind the branch is, which is how you know "
"whether a deploy is even needed."
msgstr ""
"Es la pregunta que hay que contestar antes de hacer pull. Un fichero editado"
" directamente en el servidor detiene el pull, y enterarse por el mensaje de "
"error es la vía lenta. Dice además cuántos commits de retraso lleva la rama,"
" que es como se sabe si hace falta desplegar."

#: registry.py:415
msgid "Before every deploy, and when a fix does not seem to have landed."
msgstr ""
"Antes de cada despliegue, y cuando una corrección no parece haber llegado."

#: registry.py:426
msgid "Deployed commits"
msgstr "Commits desplegados"

#: registry.py:427
msgid "Lists the last commits of the deployed code."
msgstr "Lista los últimos commits del código desplegado."

#: registry.py:429
msgid ""
"What is actually running on this server, which is not always what was "
"merged. If a change is missing here, the deploy did not happen — no need to "
"go looking for the bug anywhere else."
msgstr ""
"Lo que de verdad está corriendo en este servidor, que no siempre es lo que "
"se mergeó. Si aquí falta un cambio, el despliegue no llegó a hacerse: no "
"hace falta buscar el fallo en ningún otro sitio."

#: registry.py:433
msgid "To confirm a merged fix really reached production."
msgstr ""
"Para confirmar que un arreglo ya mergeado llegó de verdad a producción."

#: registry.py:443
msgid "Pull the latest code"
msgstr "Traer el código más reciente"

#: registry.py:444
msgid "Brings down what was merged, without ever creating a merge commit."
msgstr "Baja lo que se mergeó, sin crear nunca un commit de merge."

#: registry.py:447
msgid ""
"It runs with --ff-only, and that is the whole safety of it: if the server "
"cannot fast-forward — because something was edited here, or the branch "
"diverged — it stops and changes nothing, instead of leaving a merge commit "
"on a production checkout that nobody will review. Check the working tree "
"state first if it refuses. Pulling is not deploying: code that changes "
"models needs migrations, and code that changes CSS or JS needs the static "
"files collected. Neither happens on its own."
msgstr ""
"Se ejecuta con --ff-only, y en eso consiste toda su seguridad: si el "
"servidor no puede avanzar en línea recta —porque se editó algo aquí, o "
"porque la rama divergió— se detiene y no cambia nada, en vez de dejar un "
"commit de merge en una copia de producción que nadie va a revisar. Si se "
"niega, mira antes el estado del árbol de trabajo. Hacer pull no es "
"desplegar: el código que cambia modelos necesita migraciones, y el que "
"cambia CSS o JS necesita recopilar los estáticos. Ninguna de las dos cosas "
"pasa sola."

#: registry.py:456
msgid "After merging to master, to bring the change to the server."
msgstr "Después de mergear a master, para llevar el cambio al servidor."

#: registry.py:465
msgid ""
"This changes the running code. Right afterwards: apply migrations and "
"collect static files, or the site will be serving new code against an old "
"database and old assets."
msgstr ""
"Esto cambia el código que está corriendo. Justo después: aplicar migraciones"
" y recopilar estáticos, o el sitio servirá código nuevo contra una base de "
"datos y unos assets viejos."

#: registry.py:472
msgid "Pending model changes"
msgstr "Cambios de modelo pendientes"

#: registry.py:473
msgid "Says whether a model was changed without writing its migration."
msgstr "Dice si se cambió un modelo sin escribir su migración."

#: registry.py:476
msgid ""
"It runs with --check --dry-run, so it writes nothing: it only answers yes or"
" no. A model changed without its migration is a failure that shows up far "
"from its cause — the code deploys fine and the database breaks on the first "
"query that touches the new field."
msgstr ""
"Se ejecuta con --check --dry-run, así que no escribe nada: solo responde sí "
"o no. Un modelo cambiado sin su migración es un fallo que aparece lejos de "
"su causa: el código despliega bien y la base de datos revienta en la primera"
" consulta que toca el campo nuevo."

#: registry.py:482
msgid "Before deploying, together with the migration state."
msgstr "Antes de desplegar, junto con el estado de las migraciones."

#: registry.py:491
msgid "SQL of a migration"
msgstr "SQL de una migración"

#: registry.py:492
msgid "Shows the SQL a migration would run, without running it."
msgstr "Enseña el SQL que ejecutaría una migración, sin ejecutarlo."

#: registry.py:494
msgid ""
"The way to know what a migration is going to do before it does it — whether "
"it rewrites a table, whether it locks it, whether it drops a column. Reading"
" it takes a minute; undoing a migration on a live database does not."
msgstr ""
"Es la forma de saber qué va a hacer una migración antes de que la haga: si "
"reescribe una tabla, si la bloquea, si borra una columna. Leerlo cuesta un "
"minuto; deshacer una migración sobre una base de datos viva, no."

#: registry.py:499
msgid "Before applying a migration on a table with a lot of rows."
msgstr "Antes de aplicar una migración sobre una tabla con muchas filas."

#: registry.py:506 registry.py:1551
msgid "App"
msgstr "App"

#: registry.py:510
msgid ""
"Label of the app, as it appears in the migration state (for example: "
"buyers)."
msgstr ""
"Etiqueta de la app, tal como aparece en el estado de las migraciones (por "
"ejemplo: buyers)."

#: registry.py:516
msgid "Migration"
msgstr "Migración"

#: registry.py:520
msgid "Its number or full name, for example 0012."
msgstr "Su número o su nombre completo, por ejemplo 0012."

#: registry.py:528
msgid "Precompile CSS and JS bundles"
msgstr "Precompilar los paquetes de CSS y JS"

#: registry.py:529
msgid "Builds the compressed bundles django-compressor serves in production."
msgstr ""
"Construye los paquetes comprimidos que django-compressor sirve en "
"producción."

#: registry.py:532
msgid ""
"With offline compression on, the bundles are not built when a page is "
"requested: they have to exist beforehand. If they are missing or stale, "
"pages fail with \"you have offline compression enabled but key is missing\"."
" Run it after collecting the static files, not before."
msgstr ""
"Con la compresión offline activada, los paquetes no se construyen al pedir "
"una página: tienen que existir antes. Si faltan o están viejos, las páginas "
"fallan con «you have offline compression enabled but key is missing». "
"Ejecútalo después de recopilar los estáticos, no antes."

#: registry.py:538
msgid "After a deploy that touched CSS or JS."
msgstr "Después de un despliegue que haya tocado CSS o JS."

#: registry.py:544
msgid "Rebuild everything"
msgstr "Reconstruirlo todo"

#: registry.py:546
msgid ""
"Rebuilds even what looks up to date. Slower, and the answer when something "
"stale is being served."
msgstr ""
"Reconstruye incluso lo que parece al día. Es más lento, y es la respuesta "
"cuando se está sirviendo algo viejo."

#: registry.py:558
msgid "Django checks"
msgstr "Comprobaciones de Django"

#: registry.py:559
msgid "Looks for configuration problems without touching anything."
msgstr "Busca problemas de configuración sin tocar nada."

#: registry.py:561
msgid ""
"Runs the framework checks: models, admin, URLs, templates and security "
"settings. It is what should come out clean before any deploy."
msgstr ""
"Ejecuta las comprobaciones del framework: modelos, admin, URLs, plantillas y"
" ajustes de seguridad. Es lo que tiene que salir limpio antes de cualquier "
"despliegue."

#: registry.py:565
msgid "After changing settings.py, to confirm nothing broke."
msgstr "Después de cambiar settings.py, para confirmar que nada se rompió."

#: registry.py:571
msgid "Deploy checks"
msgstr "Comprobaciones de despliegue"

#: registry.py:574
msgid ""
"Adds the production-only checks: HTTPS, cookies, HSTS. Expect warnings in "
"development."
msgstr ""
"Añade las comprobaciones que solo aplican en producción: HTTPS, cookies, "
"HSTS. En desarrollo es normal que salgan avisos."

#: registry.py:583
msgid "Media storage"
msgstr "Almacenamiento de media"

#: registry.py:585
msgid ""
"Checks that MEDIA_ROOT points where the files really are and that the "
"sensitive folders are not served by the web server."
msgstr ""
"Comprueba que MEDIA_ROOT apunte donde están los archivos de verdad y que el "
"servidor web no sirva las carpetas sensibles."

#: registry.py:589
msgid ""
"FileField stores paths relative to MEDIA_ROOT. If the variable points "
"somewhere else, nothing is lost but Django stops finding the files: every "
"download 404s and new uploads land in the wrong place. It fails silently, "
"which is why this exists. It also checks the .htaccess files that stop the "
"web server from handing out certificates and identity documents on its own."
msgstr ""
"Un FileField guarda rutas relativas a MEDIA_ROOT. Si la variable apunta a "
"otro sitio no se pierde nada, pero Django deja de encontrar los archivos: "
"toda descarga da 404 y las subidas nuevas caen donde no es. Falla en "
"silencio, y por eso existe esto. Comprueba además los .htaccess que impiden "
"que el servidor web reparta certificados y documentos de identidad por su "
"cuenta."

#: registry.py:596
msgid "After moving the media folder, or after a deploy."
msgstr "Después de mover la carpeta de media, o después de un despliegue."

#: registry.py:602
msgid "Files per field"
msgstr "Archivos por campo"

#: registry.py:605
msgid "How many files to check per model field."
msgstr "Cuántos archivos comprobar por cada campo del modelo."

#: registry.py:609
msgid "Search under"
msgstr "Buscar dentro de"

#: registry.py:612
msgid ""
"If a file is missing, look for it by name under this path and say where it "
"is."
msgstr ""
"Si falta un archivo, búscalo por nombre bajo esta ruta y di dónde está."

#: registry.py:619
msgid "Check over HTTP"
msgstr "Comprobar por HTTP"

#: registry.py:622
msgid ""
"Actually request a sensitive file from outside and confirm the web server "
"answers 404."
msgstr ""
"Pedir de verdad un archivo sensible desde fuera y confirmar que el servidor "
"web responde 404."

#: registry.py:631
msgid "Certified documents health"
msgstr "Salud de los documentos certificados"

#: registry.py:633
msgid ""
"Checks that the three files of every certified document are on disk and that"
" their fingerprints still match."
msgstr ""
"Comprueba que los tres archivos de cada documento certificado estén en disco"
" y que sus huellas sigan cuadrando."

#: registry.py:637
msgid ""
"Two different failures: a record pointing at a deleted file, and a file "
"whose stored hash no longer matches what is on disk. The second one is the "
"serious one — it means the certification is lying."
msgstr ""
"Son dos fallos distintos: un registro que apunta a un archivo borrado, y un "
"archivo cuyo hash guardado ya no cuadra con lo que hay en disco. El grave es"
" el segundo: significa que la certificación está mintiendo."

#: registry.py:642
msgid "Monthly, and after any migration of the media folder."
msgstr "Cada mes, y después de cualquier migración de la carpeta de media."

#: registry.py:649
msgid "Cache"
msgstr "Cache"

#: registry.py:651
msgid "Checks that the cache answers and that it is shared across processes."
msgstr "Comprueba que la cache responde y que se comparte entre procesos."

#: registry.py:655
msgid ""
"Asking the VPS whether Redis is alive does not answer what matters: whether "
"this application reaches it, and whether the rate counters are shared. And "
"it cannot be judged by eye, because django-redis runs with IGNORE_EXCEPTIONS"
" so an outage does not take the login down — the price is that an "
"unreachable server returns None instead of raising, and a broken cache looks"
" exactly like an empty one. The last check is the one that decides: it "
"writes a key and reads it back from another process."
msgstr ""
"Preguntarle al VPS si Redis está vivo no contesta lo que importa: si esta "
"aplicación lo alcanza, y si los contadores de límites son compartidos. Y no "
"se puede juzgar a ojo, porque django-redis va con IGNORE_EXCEPTIONS para que"
" una avería no tumbe el acceso; el precio es que un servidor inalcanzable "
"devuelve None en vez de lanzar, y una caché rota se ve exactamente igual que"
" una vacía. La última comprobación es la que decide: escribe una clave y la "
"vuelve a leer desde otro proceso."

#: registry.py:664
msgid ""
"After pointing REDIS_URL at the VPS, and when rate limits seem not to apply."
msgstr ""
"Después de apuntar REDIS_URL al VPS, y cuando parezca que los límites de "
"tasa no se aplican."

#: registry.py:672
msgid "Background workers"
msgstr "Workers en segundo plano"

#: registry.py:674
msgid ""
"Checks whether this server can hold a worker process outside the request."
msgstr ""
"Comprueba si este servidor puede sostener un proceso worker fuera de la "
"petición."

#: registry.py:678
msgid ""
"A worker is not a library you install: it is a process that lives outside "
"the request and does not die. Shared hosting often kills anything that is "
"not serving a page, and never says so, so this is not decided by reading "
"documentation — it is measured. It also checks something easy to miss: Redis"
" working as a cache does not mean it works as a broker, because the ACL is "
"written for the cache and a broker needs other keys and other commands. That"
" one fails silently, with tasks simply vanishing."
msgstr ""
"Un worker no es una librería que se instala: es un proceso que vive fuera de"
" la petición y no se muere. El alojamiento compartido suele matar todo lo "
"que no esté sirviendo una página, y nunca lo dice, así que esto no se decide"
" leyendo documentación: se mide. Comprueba además algo que es fácil pasar "
"por alto: que Redis funcione como caché no significa que funcione como "
"broker, porque la ACL está escrita para la caché y un broker necesita otras "
"claves y otras operaciones. Ese falla en silencio, y las tareas simplemente "
"desaparecen."

#: registry.py:687
msgid "Before deciding whether Celery is worth adopting here."
msgstr "Antes de decidir si merece la pena adoptar Celery aquí."

#: registry.py:694
msgid "Launch the test process"
msgstr "Lanzar el proceso de prueba"

#: registry.py:697
msgid ""
"Starts a detached process that does nothing but write the time every 30 "
"seconds. Come back later and run this again: what matters is not that it "
"starts, but that it is still alive then."
msgstr ""
"Lanza un proceso desacoplado que no hace más que escribir la hora cada 30 "
"segundos. Vuelve más tarde y ejecútalo otra vez: lo que importa no es que "
"arranque, sino que entonces siga vivo."

#: registry.py:705
msgid "How long the test should last"
msgstr "Cuánto debe durar la prueba"

#: registry.py:709
msgid ""
"Half an hour rules out the hosting that kills everything right away, which "
"is the common case. It says nothing about the one that kills a process now "
"and then, and for that it has to run longer: 1440 is a full day."
msgstr ""
"Media hora descarta el alojamiento que lo mata todo enseguida, que es el "
"caso común. No dice nada del que mata un proceso de vez en cuando, y para "
"eso tiene que correr más tiempo: 1440 es un día entero."

#: registry.py:721
msgid ""
"Checks whether the scheduled tasks are actually installed in the crontab."
msgstr ""
"Comprueba si las tareas programadas están instaladas de verdad en el "
"crontab."

#: registry.py:725
msgid ""
"Declaring a task in CRONJOBS does not schedule it: django-crontab writes it "
"into the crontab only when someone runs \"manage.py crontab add\". Until "
"then the list exists in the code and nobody runs it — with no error and "
"nothing in the log. There is a worse case too: the installed line carries a "
"hash of the whole job definition, schedule included, so changing a schedule "
"leaves the line pointing at a job that no longer exists. The cron fires and "
"runs nothing, and from outside it looks exactly like everything working."
msgstr ""
"Declarar una tarea en CRONJOBS no la programa: django-crontab la escribe en "
"el crontab solo cuando alguien ejecuta «manage.py crontab add». Hasta "
"entonces la lista existe en el código y nadie la ejecuta, sin error y sin "
"nada en el log. Hay un caso peor: la línea instalada lleva un hash de toda "
"la definición de la tarea, horario incluido, así que cambiar un horario deja"
" la línea apuntando a una tarea que ya no existe. El cron dispara y no "
"ejecuta nada, y desde fuera se ve exactamente igual que si todo funcionara."

#: registry.py:735 registry.py:1173
msgid "When something that should run on its own has not run."
msgstr "Cuando algo que debería correr solo no ha corrido."

#: registry.py:742
msgid "Mature blockchain proofs"
msgstr "Madurar pruebas de la cadena de bloques"

#: registry.py:744
msgid ""
"Asks the calendars whether the pending proofs are already in a Bitcoin "
"block."
msgstr ""
"Pregunta a los calendarios si las pruebas pendientes ya están en un bloque "
"de Bitcoin."

#: registry.py:748
msgid ""
"This is what the scheduled task does every 15 minutes. Running it by hand "
"catches up without waiting — useful when the task was not installed, or "
"right after installing it. It is safe to run at any time: with nothing "
"pending it does not even reach the network, and a proof that has not matured"
" yet is left for the next round rather than treated as an error."
msgstr ""
"Esto es lo que hace la tarea programada cada 15 minutos. Ejecutarlo a mano "
"pone al día sin esperar, que sirve cuando la tarea no estaba instalada o "
"justo después de instalarla. Se puede ejecutar en cualquier momento: sin "
"nada pendiente ni siquiera sale a la red, y una prueba que todavía no ha "
"madurado se deja para la vuelta siguiente en vez de tratarla como un error."

#: registry.py:755
msgid "When an anchor has been waiting longer than a few hours."
msgstr "Cuando un anclaje lleva esperando más de unas horas."

#: registry.py:762
msgid "Dependencies"
msgstr "Dependencias"

#: registry.py:764
msgid ""
"Checks that requirements.txt carries everything declared in pyproject.toml."
msgstr ""
"Comprueba que requirements.txt lleve todo lo declarado en pyproject.toml."

#: registry.py:768
msgid ""
"The project uses two dependency files: pyproject.toml with uv locally, and "
"requirements.txt with pip in production, because cPanel has no uv. The "
"bridge between them is a manual export, and a manual step is a step that "
"gets forgotten. It already happened: opentimestamps was declared a day "
"before it reached requirements.txt, and in between, production had no "
"library and blockchain anchoring failed. The symptom showed up far from the "
"cause, which is the worst kind."
msgstr ""
"El proyecto usa dos ficheros de dependencias: pyproject.toml con uv en "
"local, y requirements.txt con pip en producción, porque en cPanel no hay uv."
" El puente entre los dos es un export manual, y un paso manual es un paso "
"que se olvida. Ya pasó: opentimestamps se declaró un día antes de llegar a "
"requirements.txt, y en medio producción se quedó sin la librería y el "
"anclaje en la cadena de bloques fallaba. El síntoma apareció lejos de la "
"causa, que es lo peor que hay."

#: registry.py:777
msgid "Before every deploy, and after adding any dependency."
msgstr "Antes de cada despliegue, y después de añadir cualquier dependencia."

#: registry.py:784
msgid "Blockchain anchoring"
msgstr "Anclaje en la cadena de bloques"

#: registry.py:786
msgid ""
"Checks whether this server can send hashes to the OpenTimestamps calendars."
msgstr ""
"Comprueba si este servidor puede enviar huellas a los calendarios de "
"OpenTimestamps."

#: registry.py:790
msgid ""
"When the composer says the box was sealed but not sent, the cause is almost "
"never the code: either the opentimestamps library is not installed on this "
"server, or the hosting blocks outbound connections. This tells the two "
"apart, which is what decides whether the fix is a pip install of "
"requirements.txt or a call to the provider. It also reports how the real "
"anchors are doing: a proof that has been waiting for days means nothing is "
"maturing it, not that the send failed."
msgstr ""
"Cuando el compositor dice que el resumen se selló pero no se envió, la causa"
" casi nunca es el código: o la librería opentimestamps no está instalada en "
"este servidor, o el alojamiento bloquea las conexiones salientes. Esto "
"distingue las dos, que es lo que decide si el arreglo es un pip install de "
"requirements.txt o una llamada al proveedor. Informa además de cómo van los "
"anclajes de verdad: una prueba que lleva días esperando significa que nadie "
"la está madurando, no que el envío fallara."

#: registry.py:799
msgid "When sealing reports that sending to the blockchain failed."
msgstr "Cuando el sellado avisa de que el envío a la cadena de bloques falló."

#: registry.py:806
msgid "Send a test hash"
msgstr "Enviar una huella de prueba"

#: registry.py:809
msgid ""
"Sends a made-up hash for real, to test the whole path, and keeps the proof "
"so it can be checked later. Harmless: it belongs to no document."
msgstr ""
"Envía de verdad un hash inventado, para probar el camino entero, y guarda la"
" prueba para poder comprobarla después. Es inofensivo: no pertenece a ningún"
" documento."

#: registry.py:816
msgid "Check the last test send"
msgstr "Comprobar el último envío de prueba"

#: registry.py:819
msgid ""
"Goes back to the last test hash and asks the calendars whether it made it "
"into a Bitcoin block. Nobody notifies you when it does, so this is how you "
"find out. Run it a few hours after sending."
msgstr ""
"Vuelve sobre el último hash de prueba y les pregunta a los calendarios si "
"llegó a un bloque de Bitcoin. Nadie avisa cuando llega, así que esta es la "
"forma de enterarse. Ejecútalo unas horas después del envío."

#: registry.py:829
msgid "Security check"
msgstr "Comprobación de seguridad"

#: registry.py:831
msgid "Repeats the security audit over the code as it is right now."
msgstr "Repite la auditoría de seguridad sobre el código tal como está ahora."

#: registry.py:834
msgid ""
"It looks at what a report cannot: whether a view added since then went out "
"without access control, whether a public form accepts POST with no attempt "
"limit, whether any shell execution or string-built SQL appeared. Every "
"public view has to be on a list with the reason it is public, so a new one "
"shows up here the first time this runs rather than when somebody finds it. "
"It does not replace \"check --deploy\", which looks at Django's own "
"settings; this looks at what is specific to this project. Three more "
"sections come from outside tools: bandit reads the code, pip-audit compares "
"the installed dependencies against the public advisory database — it needs "
"no credential, which is why it is the one that runs on the server — and "
"safety asks the same question against a richer database, but only in "
"development, because it always authenticates and here there is nobody to "
"answer. All three are optional, and when one is missing the report says so "
"instead of quietly shrinking."
msgstr ""
"Mira lo que un informe no puede mirar: si una vista añadida desde entonces "
"salió sin control de acceso, si un formulario público acepta POST sin límite"
" de intentos, si apareció alguna ejecución de shell o SQL construido por "
"cadenas. Toda vista pública tiene que estar en una lista con la razón por la"
" que es pública, así que una nueva aflora aquí la primera vez que esto se "
"ejecuta y no el día que alguien la encuentra. No sustituye a «check "
"--deploy», que mira los ajustes propios de Django; esto mira lo que es "
"específico de este proyecto. Otras tres secciones vienen de herramientas de "
"fuera: bandit lee el código, pip-audit compara las dependencias instaladas "
"contra la base pública de avisos —no necesita credencial, que es por lo que "
"es la que corre en el servidor— y safety hace la misma pregunta contra una "
"base más rica, pero sólo en desarrollo, porque siempre se autentica y aquí "
"no hay nadie que conteste. Las tres son opcionales, y cuando falta una el "
"informe lo dice en vez de encogerse en silencio."

#: registry.py:851
msgid "Before every deploy, together with the dependency check."
msgstr "Antes de cada despliegue, junto con la comprobación de dependencias."

#: registry.py:862
msgid "Anti-scan trap"
msgstr "Trampa anti-escaneo"

#: registry.py:864
msgid "Checks that no legitimate route collides with the scanner trap."
msgstr ""
"Comprueba que ninguna ruta legítima colisione con la trampa anti-escaneo."

#: registry.py:867
msgid ""
"The trap catches any path containing one of COMMON_ATTACK_TERMS and blocks "
"the IP. A badly chosen term hijacks a real route and locks out real users. "
"This reports collisions respecting the URLconf order, which is what actually"
" decides it."
msgstr ""
"La trampa atrapa cualquier ruta que contenga uno de los COMMON_ATTACK_TERMS "
"y bloquea la IP. Un término mal elegido secuestra una ruta real y deja fuera"
" a usuarios reales. Esto informa de las colisiones respetando el orden del "
"URLconf, que es lo que de verdad lo decide."

#: registry.py:872
msgid "Every time COMMON_ATTACK_TERMS changes."
msgstr "Cada vez que cambia COMMON_ATTACK_TERMS."

#: registry.py:879
msgid "Migration state"
msgstr "Estado de las migraciones"

#: registry.py:880
msgid "Lists which migrations are applied and which are pending."
msgstr "Lista qué migraciones están aplicadas y cuáles pendientes."

#: registry.py:882
msgid ""
"Nothing runs. It is the way to see whether the database matches the code "
"before deciding to migrate."
msgstr ""
"No se ejecuta nada. Es la forma de ver si la base de datos cuadra con el "
"código antes de decidir migrar."

#: registry.py:885
msgid "Right after deploying, before running migrate."
msgstr "Justo después de desplegar, antes de ejecutar migrate."

#: registry.py:891
msgid "Show plan"
msgstr "Mostrar el plan"

#: registry.py:893
msgid "Lists them in the order they would be applied."
msgstr "Las lista en el orden en que se aplicarían."

#: registry.py:904
msgid "Apply migrations"
msgstr "Aplicar migraciones"

#: registry.py:905
msgid "Brings the database schema up to date with the code."
msgstr "Pone el esquema de la base de datos al día con el código."

#: registry.py:907
msgid ""
"Applies every pending migration. Run the migration state check first to see "
"what is going to happen."
msgstr ""
"Aplica todas las migraciones pendientes. Ejecuta antes la comprobación del "
"estado para ver qué va a pasar."

#: registry.py:910
msgid "After deploying code that adds fields or constraints."
msgstr "Después de desplegar código que añade campos o restricciones."

#: registry.py:916 registry.py:943
msgid "No questions"
msgstr "Sin preguntas"

#: registry.py:919 registry.py:946
msgid "Required here: there is nobody to answer a prompt."
msgstr "Imprescindible aquí: no hay nadie que conteste a una pregunta."

#: registry.py:924
msgid ""
"A migration can lock tables. On a busy database, run it out of office hours."
msgstr ""
"Una migración puede bloquear tablas. En una base de datos con movimiento, "
"ejecútala fuera del horario de oficina."

#: registry.py:930
msgid "Collect static files"
msgstr "Recopilar archivos estáticos"

#: registry.py:931
msgid "Publishes the CSS and JS so the browser gets them."
msgstr "Publica el CSS y el JS para que el navegador los reciba."

#: registry.py:933
msgid ""
"In production static files are served with a hash in the name, so a change "
"is invisible until this runs. If a page looks broken after a deploy, this is"
" usually why."
msgstr ""
"En producción los estáticos se sirven con un hash en el nombre, así que un "
"cambio es invisible hasta que esto se ejecuta. Si una página se ve rota "
"después de un despliegue, suele ser por esto."

#: registry.py:937
msgid "After every deploy that touches CSS or JS."
msgstr "Después de cada despliegue que toque CSS o JS."

#: registry.py:950
msgid "Clear first"
msgstr "Limpiar primero"

#: registry.py:953
msgid ""
"Deletes what was collected before. Slower, but leaves no orphan files "
"behind."
msgstr ""
"Borra lo que se recopiló antes. Más lento, pero no deja ficheros huérfanos."

#: registry.py:962
msgid "Compile translations"
msgstr "Compilar traducciones"

#: registry.py:963
msgid "Turns the .po catalogs into the .mo files Django reads."
msgstr "Convierte los catálogos .po en los archivos .mo que lee Django."

#: registry.py:965
msgid ""
"Editing a translation changes the .po file, but Django only reads the "
"compiled .mo. Until this runs, the new text shows in English."
msgstr ""
"Editar una traducción cambia el fichero .po, pero Django solo lee el .mo "
"compilado. Hasta que esto se ejecuta, el texto nuevo sale en inglés."

#: registry.py:969
msgid "After translating with Rosetta or editing a .po by hand."
msgstr "Después de traducir con Rosetta o de editar un .po a mano."

#: registry.py:975 registry.py:1507
msgid "Language"
msgstr "Idioma"

#: registry.py:979
msgid "Which catalog to compile."
msgstr "Qué catálogo compilar."

#: registry.py:986
msgid "Clear the cache"
msgstr "Vaciar la caché"

#: registry.py:987
msgid "Empties the application cache."
msgstr "Vacía la caché de la aplicación."

#: registry.py:989
msgid ""
"Useful when something stale is being served. Note that it also clears the "
"public OTP rate-limit counters, which live in cache: right after running "
"this, those limits start from zero."
msgstr ""
"Sirve cuando se está sirviendo algo viejo. Ojo: vacía también los contadores"
" de los límites del OTP público, que viven en la caché; justo después de "
"ejecutarlo, esos límites empiezan de cero."

#: registry.py:993
msgid "After changing data that a page keeps cached."
msgstr "Después de cambiar datos que una página mantiene en caché."

#: registry.py:998
msgid ""
"It resets the public OTP rate limits. Do not run it while someone is "
"hammering the verification page."
msgstr ""
"Reinicia los límites del OTP público. No lo ejecutes mientras alguien esté "
"machacando la página de verificación."

#: registry.py:1004
msgid "Health check"
msgstr "Comprobación de salud"

#: registry.py:1005
msgid ""
"Checks the database, the cache and the mail server, from inside and from "
"outside."
msgstr ""
"Comprueba la base de datos, la caché y el servidor de correo, desde dentro y"
" desde fuera."

#: registry.py:1008
msgid ""
"The two ways of asking do not answer the same thing, and telling them apart "
"is the whole point. Asked from inside, it says whether the application "
"reaches the database, Redis and the mail server. Asked over HTTP, it also "
"crosses the web server, the certificate and the DNS. If the local one passes"
" and the HTTP one does not, the problem is in front of the application and "
"there is nothing to look for in the code. It is the same URL the warm-up "
"task hits every three minutes."
msgstr ""
"Las dos formas de preguntar no contestan lo mismo, y distinguirlas es todo "
"el sentido de esto. Preguntado desde dentro, dice si la aplicación alcanza "
"la base de datos, Redis y el servidor de correo. Preguntado por HTTP, "
"atraviesa además el servidor web, el certificado y el DNS. Si el local pasa "
"y el de HTTP no, el problema está delante de la aplicación y no hay nada que"
" buscar en el código. Es la misma URL que golpea la tarea de calentamiento "
"cada tres minutos."

#: registry.py:1017
msgid ""
"Right after a deploy, and whenever the site feels broken without an obvious "
"error."
msgstr ""
"Justo después de un despliegue, y siempre que el sitio se note roto sin un "
"error evidente."

#: registry.py:1024
msgid "Ask over HTTP"
msgstr "Preguntar por HTTP"

#: registry.py:1026
msgid "Requests the real public URL instead of checking inside this process."
msgstr ""
"Pide la URL pública de verdad en vez de comprobarlo dentro de este proceso."

#: registry.py:1034
msgid "Application log"
msgstr "Registro de la aplicación"

#: registry.py:1035
msgid "Shows the last lines of the log without opening a terminal."
msgstr "Enseña las últimas líneas del log sin abrir un terminal."

#: registry.py:1038
msgid ""
"Reading the log was the last thing that still forced an SSH session, and it "
"is the first thing needed when something fails. It reads from the end and "
"never loads the whole file. Ask for few lines and filter: a log carries "
"traces, paths, IP addresses and sometimes email addresses, and whatever is "
"shown here is also written into the run history of this very console."
msgstr ""
"Leer el log era lo último que seguía obligando a abrir una sesión SSH, y es "
"lo primero que hace falta cuando algo falla. Lee desde el final y nunca "
"carga el fichero entero. Pide pocas líneas y filtra: un log lleva trazas, "
"rutas, direcciones IP y a veces correos electrónicos, y lo que aquí se "
"enseñe queda escrito también en el historial de ejecuciones de esta misma "
"consola."

#: registry.py:1045
msgid "A page returned a 500 and there is no other clue."
msgstr "Una página devolvió un 500 y no hay más pistas."

#: registry.py:1051
msgid "Only list the files"
msgstr "Solo listar los ficheros"

#: registry.py:1053
msgid ""
"Shows the current log and the rotated ones with their size, without printing"
" any content."
msgstr ""
"Enseña el log actual y los rotados con su tamaño, sin imprimir nada de su "
"contenido."

#: registry.py:1058
msgid "Lines"
msgstr "Líneas"

#: registry.py:1061
msgid "How many lines from the end. The maximum is 2000."
msgstr "Cuántas líneas desde el final. El máximo son 2000."

#: registry.py:1065
msgid "Containing"
msgstr "Que contengan"

#: registry.py:1067
msgid "Only lines carrying this text. Literal, not a regular expression."
msgstr ""
"Solo las líneas que lleven este texto. Literal, no una expresión regular."

#: registry.py:1073
msgid "Rotated number"
msgstr "Número del rotado"

#: registry.py:1075
msgid ""
"Read stderr_old_N.log instead of the current one. Leave it empty for the "
"current log."
msgstr ""
"Leer stderr_old_N.log en vez del actual. Déjalo vacío para el log actual."

#: registry.py:1083
msgid "Rotate the log"
msgstr "Rotar el log"

#: registry.py:1084
msgid ""
"Renames the log to stderr_old_N.log when it grows past its size, and drops "
"the oldest ones."
msgstr ""
"Renombra el log a stderr_old_N.log cuando pasa de su tamaño, y descarta los "
"más viejos."

#: registry.py:1087
msgid ""
"It does nothing unless the file has passed the limit, so running it costs "
"one stat. That is why it is scheduled hourly rather than weekly: with a "
"weekly check, one bad day leaves the file at tens of megabytes before anyone"
" looks, and the limit means nothing. It also keeps only the last few rotated"
" files, because the disk here is a fixed quota and a log with no ceiling "
"fills it — and when that happens every other write fails too, not just the "
"log. The numbering continues from whatever is already there instead of "
"starting over, so a file someone referred to in an email keeps its name."
msgstr ""
"No hace nada salvo que el fichero haya pasado del límite, así que ejecutarlo"
" cuesta un stat. Por eso está programado cada hora y no cada semana: con una"
" comprobación semanal, un mal día deja el fichero en decenas de megas antes "
"de que nadie mire, y el límite no significa nada. Guarda además solo los "
"últimos rotados, porque aquí el disco es una cuota fija y un log sin techo "
"la llena — y cuando eso pasa fallan todas las demás escrituras, no solo la "
"del log. La numeración continúa desde lo que ya hay en vez de empezar de "
"cero, así que un fichero que alguien citó en un correo conserva su nombre."

#: registry.py:1098
msgid "It runs on its own every hour; by hand only to force it."
msgstr "Se ejecuta solo cada hora; a mano, únicamente para forzarlo."

#: registry.py:1104
msgid "Rotate now"
msgstr "Rotar ahora"

#: registry.py:1106
msgid "Rotates even if it has not reached the size."
msgstr "Rota aunque no haya llegado al tamaño."

#: registry.py:1110
msgid "Size in MB"
msgstr "Tamaño en MB"

#: registry.py:1113
msgid "Rotate from this size on."
msgstr "Rotar a partir de este tamaño."

#: registry.py:1117
msgid "Rotated files to keep"
msgstr "Rotados que se conservan"

#: registry.py:1120
msgid ""
"The older ones are deleted. 0 keeps them all, and fills the disk sooner or "
"later."
msgstr ""
"Los más viejos se borran. Con 0 se guardan todos, y tarde o temprano se "
"llena el disco."

#: registry.py:1128
msgid "Locate a static file"
msgstr "Localizar un archivo estático"

#: registry.py:1129
msgid "Says which folder a CSS, JS or image file is really being served from."
msgstr ""
"Dice desde qué carpeta se está sirviendo de verdad un fichero CSS, JS o de "
"imagen."

#: registry.py:1132
msgid ""
"When a page looks broken after a deploy, the question is whether the file "
"was collected at all and which copy won. This answers both: it lists every "
"place the file appears, in the order Django searches them."
msgstr ""
"Cuando una página se ve rota después de un despliegue, la pregunta es si el "
"fichero llegó a recopilarse y qué copia ganó. Esto contesta las dos: lista "
"todos los sitios donde aparece el fichero, en el orden en que Django los "
"busca."

#: registry.py:1137
msgid "A stylesheet 404s, or a change to it does not show up."
msgstr "Una hoja de estilos da 404, o un cambio en ella no se ve."

#: registry.py:1143
msgid "Path of the file"
msgstr "Ruta del fichero"

#: registry.py:1147
msgid "Relative to the static folder, for example css/aegis_header.css."
msgstr "Relativa a la carpeta de estáticos, por ejemplo css/aegis_header.css."

#: registry.py:1153
msgid "Only the winning copy"
msgstr "Solo la copia que gana"

#: registry.py:1155
msgid "Stops at the first match, which is the one actually served."
msgstr ""
"Se detiene en la primera coincidencia, que es la que se sirve de verdad."

#: registry.py:1163
msgid "Installed scheduled lines"
msgstr "Líneas programadas instaladas"

#: registry.py:1164
msgid "Lists the lines django-crontab has written into the crontab."
msgstr "Lista las líneas que django-crontab ha escrito en el crontab."

#: registry.py:1167
msgid ""
"What is really installed, as opposed to what CRONJOBS declares. The two "
"drift apart on their own: the installed line carries a hash of the whole job"
" definition, so changing a schedule leaves the old line pointing at a job "
"that no longer exists. Read it alongside the scheduled-tasks check, which "
"compares the two."
msgstr ""
"Lo que hay instalado de verdad, frente a lo que declara CRONJOBS. Los dos se"
" separan solos: la línea instalada lleva un hash de toda la definición de la"
" tarea, así que cambiar un horario deja la línea vieja apuntando a una tarea"
" que ya no existe. Léelo junto a la comprobación de tareas programadas, que "
"compara las dos."

#: registry.py:1182
msgid "Install the scheduled tasks"
msgstr "Instalar las tareas programadas"

#: registry.py:1183
msgid "Writes every job declared in CRONJOBS into the crontab."
msgstr "Escribe en el crontab todas las tareas declaradas en CRONJOBS."

#: registry.py:1185
msgid ""
"Declaring a task in settings schedules nothing until this runs. It is also "
"the fix when a schedule changed: it is safe to run repeatedly, because "
"django-crontab removes its own lines before writing them again — it never "
"touches lines it did not write."
msgstr ""
"Declarar una tarea en los settings no programa nada hasta que esto se "
"ejecuta. Es también el arreglo cuando cambia un horario: se puede ejecutar "
"las veces que haga falta, porque django-crontab quita sus propias líneas "
"antes de volver a escribirlas — nunca toca líneas que no escribió él."

#: registry.py:1190
msgid ""
"After deploying a change to CRONJOBS, or when the scheduled-tasks check "
"reports nothing installed."
msgstr ""
"Después de desplegar un cambio en CRONJOBS, o cuando la comprobación de "
"tareas programadas dice que no hay nada instalado."

#: registry.py:1198
msgid ""
"It rewrites this account crontab lines for this project. Run the scheduled-"
"tasks check afterwards to confirm what ended up there."
msgstr ""
"Reescribe las líneas del crontab de esta cuenta para este proyecto. Ejecuta "
"después la comprobación de tareas programadas para confirmar qué acabó ahí."

#: registry.py:1204
msgid "Uninstall the scheduled tasks"
msgstr "Desinstalar las tareas programadas"

#: registry.py:1205
msgid "Removes this project lines from the crontab."
msgstr "Quita del crontab las líneas de este proyecto."

#: registry.py:1207
msgid ""
"Nothing scheduled runs after this: anchors stop maturing, the daily code "
"stops being issued. It is half of the repair when a schedule changed — "
"remove, then install — and on its own it is only for taking the platform out"
" of service."
msgstr ""
"Después de esto no se ejecuta nada programado: los anclajes dejan de "
"madurar, el código diario deja de emitirse. Es la mitad del arreglo cuando "
"cambia un horario —quitar y volver a instalar— y por sí solo sirve "
"únicamente para dejar la plataforma fuera de servicio."

#: registry.py:1212
msgid "Before reinstalling the tasks after changing a schedule."
msgstr "Antes de reinstalar las tareas después de cambiar un horario."

#: registry.py:1219
msgid "Nothing runs on its own until the tasks are installed again."
msgstr "No se ejecuta nada solo hasta que las tareas se vuelvan a instalar."

#: registry.py:1224
msgid "Failed login attempts"
msgstr "Intentos de acceso fallidos"

#: registry.py:1225
msgid "Lists the login failures axes is counting right now."
msgstr "Lista los fallos de acceso que axes está contando ahora mismo."

#: registry.py:1227
msgid ""
"Where to look when someone says they cannot log in. It tells a lockout apart"
" from a wrong password, which look identical from the outside. Note that a "
"lockout is per (IP, user) pair, so the same person can be locked out from "
"the office and get in from their phone."
msgstr ""
"Es donde hay que mirar cuando alguien dice que no puede entrar. Distingue un"
" bloqueo de una contraseña equivocada, que desde fuera se ven igual. Ojo: el"
" bloqueo va por pareja (IP, usuario), así que la misma persona puede estar "
"bloqueada desde la oficina y entrar desde su móvil."

#: registry.py:1233
msgid "A user reports that their password stopped working."
msgstr "Un usuario avisa de que su contraseña dejó de funcionar."

#: registry.py:1240
msgid "Unlock an IP"
msgstr "Desbloquear una IP"

#: registry.py:1241
msgid "Clears the login lockout for one IP address."
msgstr "Quita el bloqueo de acceso de una sola dirección IP."

#: registry.py:1243
msgid ""
"The surgical fix when a real user is locked out: it frees that address and "
"nobody else. This is about the login lockout, which is a different thing "
"from the anti-scan IP block — that one is undone from the blocked-IP table "
"or the whitelist, and shows up as a plain 404 rather than a login error."
msgstr ""
"Es el arreglo quirúrgico cuando un usuario real se queda bloqueado: libera "
"esa dirección y ninguna otra. Esto va del bloqueo de acceso, que es otra "
"cosa distinta del bloqueo por IP de la trampa anti-escaneo: ese se deshace "
"desde la tabla de IP bloqueadas o desde la lista blanca, y se ve como un 404"
" normal y corriente, no como un error de acceso."

#: registry.py:1249
msgid "An office got locked out after several typed passwords."
msgstr "Una oficina se quedó bloqueada después de teclear varias contraseñas."

#: registry.py:1255
msgid "IP address"
msgstr "Dirección IP"

#: registry.py:1259
msgid "The one showing in the failed attempts."
msgstr "La que aparece en los intentos fallidos."

#: registry.py:1267
msgid "Unlock one person"
msgstr "Desbloquear a una persona"

#: registry.py:1268
msgid "Clears the login lockout for one username, from any address."
msgstr ""
"Quita el bloqueo de acceso de un nombre de usuario, desde cualquier "
"dirección."

#: registry.py:1271
msgid ""
"The lockout is per (IP, user) pair, so someone locked out at the office is "
"still locked out from there after moving to their phone and back. This frees"
" that person everywhere without touching anyone else who shares their "
"address."
msgstr ""
"El bloqueo va por pareja (IP, usuario), así que quien se bloqueó en la "
"oficina sigue bloqueado allí aunque se pase al móvil y vuelva. Esto libera a"
" esa persona en todas partes sin tocar a nadie más que comparta su "
"dirección."

#: registry.py:1276
msgid "A user is still locked out after changing network."
msgstr "Un usuario sigue bloqueado después de cambiar de red."

#: registry.py:1282 registry.py:1309
msgid "Username"
msgstr "Nombre de usuario"

#: registry.py:1286
msgid "As it appears in the failed attempts."
msgstr "Tal como aparece en los intentos fallidos."

#: registry.py:1294
msgid "Second-factor status"
msgstr "Estado del segundo factor"

#: registry.py:1295
msgid "Says whether a user has their second factor set up."
msgstr "Dice si un usuario tiene configurado su segundo factor."

#: registry.py:1297
msgid ""
"It changes nothing and shows no secret: only whether the device is "
"registered. It is the first question to answer when someone says they cannot"
" get into the panel, because the admin turns away anyone without a verified "
"second factor — and it does so with a 404, which from outside looks like the"
" page not existing."
msgstr ""
"No cambia nada y no enseña ningún secreto: solo si el dispositivo está "
"registrado. Es la primera pregunta que hay que contestar cuando alguien dice"
" que no puede entrar al panel, porque el admin rechaza a quien no tenga un "
"segundo factor verificado — y lo hace con un 404, que desde fuera se ve como"
" que la página no existe."

#: registry.py:1303
msgid "Someone reports the admin URL \"does not exist\" for them."
msgstr "Alguien avisa de que a él la URL del panel «no existe»."

#: registry.py:1313
msgid "Whose status to check."
msgstr "De quién se comprueba el estado."

#: registry.py:1321
msgid "Unlock every login"
msgstr "Desbloquear todos los accesos"

#: registry.py:1322
msgid "Clears all login lockouts at once."
msgstr "Quita de golpe todos los bloqueos de acceso."

#: registry.py:1324
msgid ""
"It frees everyone, an attacker in the middle of guessing passwords included."
" Prefer unlocking a single IP: this one is for when the lockout is clearly "
"the platform own fault and several people are stuck."
msgstr ""
"Libera a todo el mundo, incluido quien esté a mitad de probar contraseñas. "
"Es mejor desbloquear una sola IP: esto es para cuando el bloqueo es "
"claramente culpa de la propia plataforma y hay varias personas atascadas."

#: registry.py:1329
msgid "After a change that locked out legitimate users in bulk."
msgstr "Después de un cambio que dejó fuera a usuarios legítimos en bloque."

#: registry.py:1334
msgid "It also resets the counter of anyone currently guessing passwords."
msgstr ""
"Reinicia también el contador de quien esté probando contraseñas en este "
"momento."

#: registry.py:1340
msgid "Expired sessions"
msgstr "Sesiones caducadas"

#: registry.py:1341
msgid "Deletes sessions that already expired."
msgstr "Borra las sesiones que ya caducaron."

#: registry.py:1343
msgid ""
"Django never cleans up the session table on its own, so it only grows. It "
"removes nothing that is still valid: nobody gets logged out by running this."
msgstr ""
"Django nunca limpia la tabla de sesiones por su cuenta, así que solo crece. "
"No quita nada que siga siendo válido: ejecutarlo no saca a nadie de su "
"sesión."

#: registry.py:1347
msgid "Housekeeping, when the session table has grown a lot."
msgstr "Mantenimiento, cuando la tabla de sesiones ha crecido mucho."

#: registry.py:1354
msgid "Send a test email"
msgstr "Enviar un correo de prueba"

#: registry.py:1355
msgid "Sends one message to check the mail settings really work."
msgstr ""
"Envía un mensaje para comprobar que la configuración de correo funciona de "
"verdad."

#: registry.py:1357
msgid ""
"Email fails silently more often than anything else here, and it fails where "
"it hurts: the OTP of the public verification, the password recovery link, "
"the daily code, the service order. This separates a bad configuration from a"
" message that left and was filtered — if it arrives, the platform did its "
"part."
msgstr ""
"El correo falla en silencio más que ninguna otra cosa aquí, y falla donde "
"duele: el OTP de la verificación pública, el enlace de recuperación de "
"contraseña, el código diario, la orden de servicio. Esto separa una "
"configuración mala de un mensaje que salió y lo filtraron: si llega, la "
"plataforma hizo su parte."

#: registry.py:1363
msgid "After changing the mail settings, or when OTPs are not arriving."
msgstr ""
"Después de cambiar la configuración de correo, o cuando los códigos no "
"llegan."

#: registry.py:1370
msgid "Recipient"
msgstr "Destinatario"

#: registry.py:1374
msgid "An address you can actually check."
msgstr "Una dirección que puedas mirar de verdad."

#: registry.py:1380
msgid "This sends real email."
msgstr "Esto envía correo real."

#: registry.py:1384
msgid "Announce a legal document change"
msgstr "Anunciar un cambio en un documento legal"

#: registry.py:1385
msgid ""
"Emails every user about an approved change they have not been told about "
"yet."
msgstr ""
"Manda un correo a cada usuario sobre un cambio aprobado del que todavía no "
"se le ha avisado."

#: registry.py:1388
msgid ""
"Entering the platform after a change is recorded as accepting it, and that "
"only holds if the person was told first — so this is what opens that door, "
"not the approval. It runs by itself every half hour; this entry is for "
"sending it now, or for checking with a dry run who would get it. With "
"nothing pending it is one query and it stops."
msgstr ""
"Entrar en la plataforma después de un cambio se registra como aceptarlo, y "
"eso sólo vale si antes se avisó a la persona, así que es esto lo que abre "
"esa puerta y no la aprobación. Se ejecuta solo cada media hora; esta entrada"
" es para mandarlo ya, o para comprobar en seco a quién le llegaría. Sin nada"
" pendiente es una consulta y se para."

#: registry.py:1395
msgid ""
"Right after approving a new version, instead of waiting for the scheduled "
"run."
msgstr ""
"Justo después de aprobar una versión nueva, en vez de esperar a la pasada "
"programada."

#: registry.py:1402
msgid "Only say who would get it"
msgstr "Sólo decir a quién le llegaría"

#: registry.py:1404
msgid "Sends nothing and marks nothing."
msgstr "No manda nada ni marca nada."

#: registry.py:1408
msgid "Without the dry run this sends real email to every user."
msgstr "Sin la opción en seco, esto manda correo real a todos los usuarios."

#: registry.py:1412
msgid "Daily GEA code"
msgstr "Código diario de GEA"

#: registry.py:1413
msgid "Issues the daily code and mails it to its recipients."
msgstr "Emite el código diario y lo envía por correo a sus destinatarios."

#: registry.py:1415
msgid ""
"The same thing the scheduled job does. Running it by hand sends real email, "
"so only use it if the scheduled run failed."
msgstr ""
"Lo mismo que hace la tarea programada. Ejecutarlo a mano envía correo de "
"verdad, así que úsalo solo si la ejecución programada falló."

#: registry.py:1418
msgid "The cron did not run and the code for today is missing."
msgstr "El cron no se ejecutó y falta el código de hoy."

#: registry.py:1422
msgid "This sends real email to the configured recipients."
msgstr "Esto envía correo real a los destinatarios configurados."

#: registry.py:1436
msgid "Create an app"
msgstr "Crear una app"

#: registry.py:1437
msgid "Creates a new app with the project layout already set up."
msgstr "Crea una app nueva con la estructura del proyecto ya puesta."

#: registry.py:1439
msgid ""
"It writes the app with its full dotted name, its urls.py and its locale "
"folder, which is what makes it fit this project — a plain startapp leaves "
"the name wrong and the URLconf empty. It does not register it: adding it to "
"the right group in settings.py is still a manual step, and that ordering "
"decides the URLconf and LOCALE_PATHS order."
msgstr ""
"Escribe la app con su nombre completo con puntos, su urls.py y su carpeta "
"locale, que es lo que hace que encaje en este proyecto: un startapp normal "
"deja el nombre mal y el URLconf vacío. No la registra: añadirla al grupo que"
" le toca en settings.py sigue siendo un paso manual, y ese orden decide el "
"del URLconf y el de LOCALE_PATHS."

#: registry.py:1446
msgid "Starting a new domain area, on a development machine."
msgstr "Al empezar un área nueva del dominio, en una máquina de desarrollo."

#: registry.py:1453
msgid "Path of the app"
msgstr "Ruta de la app"

#: registry.py:1457
msgid "For example apps/project/specific/documents/reports."
msgstr "Por ejemplo apps/project/specific/documents/reports."

#: registry.py:1463
msgid ""
"It writes new files into the repository. They are not in git until someone "
"commits them."
msgstr ""
"Escribe ficheros nuevos en el repositorio. No están en git hasta que alguien"
" los commitea."

#: registry.py:1469
msgid "Write migrations"
msgstr "Escribir migraciones"

#: registry.py:1470
msgid "Writes the migration files for the model changes."
msgstr "Escribe los ficheros de migración de los cambios de modelo."

#: registry.py:1472
msgid ""
"The writing version of the pending-changes check. It belongs on a "
"development machine because a migration is source code: it goes through git,"
" gets reviewed and gets deployed. Generated on the server it is a file "
"nobody has seen, which the next pull either wipes out or conflicts with."
msgstr ""
"Es la versión que escribe de la comprobación de cambios pendientes. Va en "
"una máquina de desarrollo porque una migración es código fuente: pasa por "
"git, se revisa y se despliega. Generada en el servidor es un fichero que "
"nadie ha visto, y el siguiente pull o lo borra o choca con él."

#: registry.py:1478
msgid "After changing a model, before committing."
msgstr "Después de cambiar un modelo, antes de commitear."

#: registry.py:1484
msgid "A migration is source code: commit it, do not leave it on a server."
msgstr ""
"Una migración es código fuente: commitéala, no la dejes en un servidor."

#: registry.py:1490
msgid "Extract translatable text"
msgstr "Extraer el texto traducible"

#: registry.py:1491
msgid "Rewrites the .po catalogs with the strings found in the code."
msgstr "Reescribe los catálogos .po con las cadenas encontradas en el código."

#: registry.py:1494
msgid ""
"It rewrites every catalog in the project, so it belongs where the result can"
" be reviewed and committed. It also needs gettext installed. On the server "
"the useful half is the other one — compiling the catalogs — which is "
"available everywhere."
msgstr ""
"Reescribe todos los catálogos del proyecto, así que va donde el resultado se"
" pueda revisar y commitear. Necesita además gettext instalado. En el "
"servidor la mitad útil es la otra —compilar los catálogos— que sí está "
"disponible en todas partes."

#: registry.py:1499
msgid "After adding text wrapped in gettext, on a development machine."
msgstr ""
"Después de añadir texto envuelto en gettext, en una máquina de desarrollo."

#: registry.py:1511
msgid "Which catalog to rebuild."
msgstr "Qué catálogo reconstruir."

#: registry.py:1518
msgid "Models from the schema"
msgstr "Modelos a partir del esquema"

#: registry.py:1519
msgid "Prints the models that would match the tables already in the database."
msgstr ""
"Imprime los modelos que corresponderían a las tablas que ya hay en la base "
"de datos."

#: registry.py:1522
msgid ""
"Reads the schema and writes nothing. It is for comparing what the database "
"really has against what the code declares, when the two have drifted apart. "
"The output is a draft, never something to paste in as is."
msgstr ""
"Lee el esquema y no escribe nada. Sirve para comparar lo que de verdad hay "
"en la base de datos con lo que declara el código, cuando los dos se han "
"separado. La salida es un borrador, nunca algo que pegar tal cual."

#: registry.py:1527
msgid "Chasing a mismatch between a table and its model."
msgstr "Persiguiendo un desajuste entre una tabla y su modelo."

#: registry.py:1535
msgid "SQL to fix the sequences"
msgstr "SQL para arreglar las secuencias"

#: registry.py:1536
msgid "Prints the SQL that puts the auto-increment counters back in place."
msgstr ""
"Imprime el SQL que vuelve a poner en su sitio los contadores de "
"autoincremento."

#: registry.py:1539
msgid ""
"It only prints: nothing runs. It is what is needed after loading rows with "
"explicit ids, when the counter is left behind and the next insert collides "
"with an existing row."
msgstr ""
"Solo imprime: no se ejecuta nada. Es lo que hace falta después de cargar "
"filas con ids explícitos, cuando el contador se queda atrás y el siguiente "
"insert choca con una fila que ya existe."

#: registry.py:1543
msgid "After importing data with fixed ids into a development database."
msgstr ""
"Después de importar datos con ids fijos en una base de datos de desarrollo."

#: registry.py:1555
msgid "Label of the app, for example buyers."
msgstr "Etiqueta de la app, por ejemplo buyers."

#: registry.py:1563
msgid "Run the test suite"
msgstr "Ejecutar la suite de pruebas"

#: registry.py:1564
msgid "Runs the tests against SQLite in memory."
msgstr "Ejecuta las pruebas contra SQLite en memoria."

#: registry.py:1566
msgid ""
"They run with app_core.settings_test because the MySQL user on cPanel cannot"
" create the test_ database — which is also why this is a development-only "
"entry. Half of the suite reproduces holes that were already closed, so a red"
" result is worth reading before assuming the test is stale."
msgstr ""
"Se ejecutan con app_core.settings_test porque el usuario de MySQL en cPanel "
"no puede crear la base test_ — que es también por lo que esta entrada es "
"solo de desarrollo. La mitad de la suite reproduce agujeros que ya se "
"cerraron, así que un resultado en rojo merece leerse antes de dar por hecho "
"que la prueba está vieja."

#: registry.py:1572
msgid "Before pushing, on a development machine."
msgstr "Antes de hacer push, en una máquina de desarrollo."

#: registry.py:1582
msgid "Runs the suite and writes the summary the charts read."
msgstr "Ejecuta la suite y escribe el resumen que leen las gráficas."

#: registry.py:1584
msgid ""
"The same suite as the entry above, but keeping what it usually throws away: "
"which test, from which app, how long it took and how it ended. It also "
"measures coverage when coverage is installed — it is a development tool and "
"is not in requirements.txt, so without it the run still produces the result "
"summary and says the coverage was not measured. It runs in a subprocess of "
"its own because coverage has to start before Django imports anything."
msgstr ""
"La misma suite que la entrada de arriba, pero guardando lo que normalmente "
"se tira: qué prueba, de qué app, cuánto tardó y cómo acabó. Mide además la "
"cobertura cuando coverage está instalado — es una herramienta de desarrollo "
"y no está en requirements.txt, así que sin ella la ejecución sigue dando el "
"resumen de resultados y dice que la cobertura no se midió. Corre en un "
"subproceso propio porque coverage tiene que arrancar antes de que Django "
"importe nada."

#: registry.py:1593
msgid "Before a release, to see which app is thin on tests."
msgstr "Antes de una entrega, para ver qué app va floja de pruebas."

#: registry.py:1600
msgid "Skip coverage"
msgstr "Saltar la cobertura"

#: registry.py:1602
msgid "Only the results. Runs noticeably faster."
msgstr "Solo los resultados. Va bastante más rápido."

#: registry.py:1606
msgid "Also the navigable HTML"
msgstr "También el HTML navegable"

#: registry.py:1608
msgid ""
"Writes htmlcov/, which is what shows the missing line. Only useful on a "
"machine you can browse."
msgstr ""
"Escribe htmlcov/, que es lo que enseña la línea que falta. Solo sirve en una"
" máquina donde puedas navegar."

#: registry.py:1620
msgid "Database backup"
msgstr "Copia de seguridad de la base de datos"

#: registry.py:1621
msgid "Writes a full dump of the database to disk."
msgstr "Escribe un volcado completo de la base de datos en disco."

#: registry.py:1623
msgid ""
"Produces a file with everything in the database. Where it lands matters: "
"anyone who can read that path can read every record, including the encrypted"
" personal data fields."
msgstr ""
"Produce un fichero con todo lo que hay en la base de datos. Dónde acaba "
"importa: quien pueda leer esa ruta puede leer todos los registros, incluidos"
" los campos de datos personales cifrados."

#: registry.py:1627
msgid "Right before applying a risky migration."
msgstr "Justo antes de aplicar una migración arriesgada."

#: registry.py:1633
msgid "Output folder"
msgstr "Carpeta de salida"

#: registry.py:1636
msgid "Folder for the dump, relative to the project root."
msgstr "Carpeta para el volcado, relativa a la raíz del proyecto."

#: registry.py:1642
msgid ""
"The dump contains every record. Keep it out of any folder the web server can"
" serve."
msgstr ""
"El volcado lleva todos los registros. Mantenlo fuera de cualquier carpeta "
"que el servidor web pueda servir."

#: runner.py:120
#, python-format
msgid "%(label)s is required."
msgstr "%(label)s es obligatorio."

#: runner.py:129
#, python-format
msgid "%(label)s must be a whole number."
msgstr "%(label)s tiene que ser un número entero."

#: runner.py:136
#, python-format
msgid "%(label)s: \"%(value)s\" is not one of the allowed values."
msgstr "%(label)s: \"%(value)s\" no es uno de los valores permitidos."

#: runner.py:153
#, python-format
msgid "%(label)s contains characters that are not allowed."
msgstr "%(label)s contiene caracteres que no están permitidos."

#: runner.py:279
msgid ""
"The program could not be found. For manage.py, check BASE_DIR; for git, "
"check that it is on the PATH."
msgstr ""
"No se encontró el programa. Para manage.py, revisa BASE_DIR; para git, "
"comprueba que esté en el PATH."

#: summary.py:34
msgid "Pass"
msgstr "Pasa"

#: summary.py:35
msgid "Fail"
msgstr "Falla"

#: summary.py:36
msgid "Error"
msgstr "Error"

#: summary.py:37
msgid "Skipped"
msgstr "Saltada"

#: summary.py:38
msgid "Expected failure"
msgstr "Fallo esperado"

#~ msgid "manage.py could not be found. Check BASE_DIR."
#~ msgstr "No se encontró manage.py. Revise BASE_DIR."
