msgstr "Espere %(seconds)s segundos antes de solicitar un nuevo código."

#: .\apps\project\specific\documents\certificates\views.py:149
#: .\apps\project\specific\documents\certificates\views.py:277
msgid "Too many code requests. Try again later."
msgstr "Demasiadas solicitudes de código. Inténtalo más tarde."

#: .\apps\project\specific\documents\certificates\views.py:159
msgid "A new verification code has been sent to your email."
msgstr "Se ha enviado un nuevo código de verificación a su correo electrónico."

#: .\apps\project\specific\documents\certificates\views.py:230
msgid ""
"This file is not valid: it is neither the original nor a certified digital "
"copy issued by this platform."
msgstr ""
"Este archivo no es válido: no es el original ni una copia digital "
"certificada emitida por esta plataforma."

#: .\apps\project\specific\documents\certificates\views.py:240
msgid ""
"This file carries the hidden watermark of the platform, so it originated "
"from a certified copy, but its content has been modified. It is not a valid "
"certified copy."
msgstr ""
"Este archivo lleva la marca de agua oculta de la plataforma, por lo que "
"procede de una copia certificada, pero su contenido ha sido modificado. No "
"es una copia certificada válida."

#: .\apps\project\specific\documents\certificates\views.py:292
msgid "Invalid or expired code."
msgstr "Código inválido o caducado."

#: .\apps\project\specific\documents\certificates\views.py:306
msgid "Document not found."
msgstr "Documento no encontrado."

#: .\apps\project\specific\documents\certificates\views.py:309
msgid "We could not verify the document with the provided data."
msgstr "No pudimos verificar el documento con los datos proporcionados."

#: .\apps\project\specific\documents\certificates\views.py:373
msgid "Valid"
msgstr "Válido"

#: .\apps\project\specific\documents\certificates\views.py:376
msgid "Not certified"
msgstr "Sin certificar"

#: .\apps\project\specific\documents\certificates\views.py:408
msgid ""
"Verified file: this is the ORIGINAL document filed with the platform, "
"unmodified."
msgstr ""
"Archivo verificado: es el documento ORIGINAL depositado en la plataforma, "
"sin modificar."

#: .\apps\project\specific\documents\certificates\views.py:412
msgid ""
"Verified file: this is the CERTIFIED document, with its codes embedded, "
"unmodified."
msgstr ""
"Archivo verificado: es el documento CERTIFICADO, con sus códigos "
"incrustados, sin modificar."

#: .\apps\project\specific\documents\certificates\views.py:416
msgid ""
"Verified file: this is a CERTIFIED DIGITAL COPY of the original and it is "
"valid."
msgstr ""
"Archivo verificado: es una COPIA DIGITAL CERTIFICADA del original y es "
"válida."

#: .\apps\project\specific\documents\certificates\views.py:423
msgid "Recognised by the exact fingerprint of the file (SHA-256)."
msgstr "Reconocido por la huella exacta del archivo (SHA-256)."

#: .\apps\project\specific\documents\certificates\views.py:426
msgid ""
"The bytes of the file changed (typically document metadata rewritten while "
"it was emailed or re-saved), but its renderable content matches the "
"certified one exactly, page by page."
msgstr ""
"Los bytes del archivo han cambiado (normalmente, metadatos del documento "
"reescritos al enviarlo por correo o al reguardarlo), pero su contenido "
"visible coincide exactamente con el certificado, página a página."

#: .\apps\project\specific\documents\certificates\views.py:551
msgid ""
"This platform is not configured with a public signing key. Certification "
"records are sealed with a symmetric HMAC that only the platform itself can "
"verify."
msgstr ""
"Esta plataforma no tiene configurada una clave pública de firma. Los "
"registros de certificación se sellan con un HMAC simétrico que solo la "
"propia plataforma puede verificar."

#: .\apps\project\specific\documents\certificates\views.py:566
msgid ""
"The \"seal.signature\" field of a GEA certification record, over every other "
"field serialised as compact JSON with sorted keys, UTF-8."
msgstr ""
"El campo \"seal.signature\" de un registro de certificación de GEA, sobre "
"todos los demás campos serializados como JSON compacto con las claves "
"ordenadas, en UTF-8."

#: .\apps\project\specific\documents\certificates\views.py:652
msgid "AEGIS Documents Certificates"
msgstr "Certificados de documentos AEGIS"

#: .\apps\project\specific\documents\certificates\views.py:654
msgid ""
"Verify documents protected and issued through the AEGIS certification system."
msgstr ""
"Verifica documentos protegidos y emitidos a través del sistema de "
"certificación AEGIS."

#: .\apps\project\specific\documents\certificates\views.py:662
msgid "IPCON Employee Certificate"
msgstr "Certificado de empleado IPCON"

#: .\apps\project\specific\documents\certificates\views.py:664
