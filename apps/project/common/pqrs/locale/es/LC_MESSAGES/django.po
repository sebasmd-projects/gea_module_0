#: .\apps\project\common\pqrs\admin.py:32
msgid "deadline"
msgstr "plazo"

#: .\apps\project\common\pqrs\admin.py:37
msgid "Overdue"
msgstr "Vencida"

#: .\apps\project\common\pqrs\admin.py:38
msgid "Due within 3 business days"
msgstr "Vence en 3 días hábiles o menos"

#: .\apps\project\common\pqrs\admin.py:39
msgid "Open"
msgstr "Abierta"

#: .\apps\project\common\pqrs\admin.py:101
msgid "Filing"
msgstr "Radicación"

#: .\apps\project\common\pqrs\admin.py:105
msgid "Who is filing"
msgstr "Quién radica"

#: .\apps\project\common\pqrs\admin.py:111
msgid "Where to reach them"
msgstr "Cómo contactarle"

#: .\apps\project\common\pqrs\admin.py:116
msgid "The request"
msgstr "La solicitud"

#: .\apps\project\common\pqrs\admin.py:119
msgid "Handling"
msgstr "Trámite"

#: .\apps\project\common\pqrs\admin.py:123
msgid "Record of the authorisation"
msgstr "Constancia de la autorización"

#: .\apps\project\common\pqrs\admin.py:128
msgid ""
"Article 9 of Law 1581 requires keeping proof of the authorisation. A ticked "
"box is not proof unless when and from where is recorded."
msgstr ""
"El artículo 9 de la Ley 1581 exige conservar prueba de la autorización. Una "
"casilla marcada no es prueba si no queda registrado cuándo y desde dónde se "
"marcó."

#: .\apps\project\common\pqrs\admin.py:151
msgid "Deadline"
msgstr "Plazo"

#: .\apps\project\common\pqrs\admin.py:168
#, python-format
msgid "%(days)s business days overdue"
msgstr "Vencida hace %(days)s días hábiles"

#: .\apps\project\common\pqrs\admin.py:171
#: .\apps\project\common\pqrs\admin.py:174
#, python-format
msgid "%(days)s business days left"
msgstr "Quedan %(days)s días hábiles"

#: .\apps\project\common\pqrs\admin.py:182
msgid "Who"
msgstr "Quién"

#: .\apps\project\common\pqrs\admin.py:188
msgid "Extend the deadline (once, as the law allows)"
msgstr "Prorrogar el plazo (una sola vez, como permite la ley)"

#: .\apps\project\common\pqrs\admin.py:203
#, python-format
msgid ""
"%(count)s extended. Remember the law also requires telling the person why "
"and giving them the new date."
msgstr ""
"%(count)s prorrogadas. Recuerda que la ley exige además informar al "
"solicitante de los motivos y de la nueva fecha."

#: .\apps\project\common\pqrs\admin.py:209
#, python-format
msgid "%(count)s were already extended: the law allows one extension only."
msgstr "%(count)s ya estaban prorrogadas: la ley permite una sola prórroga."

#: .\apps\project\common\pqrs\apps.py:8
#: .\apps\project\common\pqrs\views.py:149
msgid "Requests and complaints (PQRS)"
msgstr "Peticiones, quejas, reclamos y sugerencias (PQRS)"

#: .\apps\project\common\pqrs\forms.py:56
#, python-format
msgid "Only these formats are accepted: %(formats)s."
msgstr "Solo se aceptan estos formatos: %(formats)s."

#: .\apps\project\common\pqrs\forms.py:62
#, python-format
msgid "The file is too large. The maximum is %(size)s MB."
msgstr "El archivo es demasiado grande. El máximo son %(size)s MB."

#: .\apps\project\common\pqrs\forms.py:73
#: .\apps\project\common\pqrs\views.py:95
msgid "Type of request"
msgstr "Tipo de solicitud"

#: .\apps\project\common\pqrs\forms.py:77
msgid ""
"Access and query are answered within 10 business days. The rest are handled "
"as claims, within 15."
msgstr ""
"El acceso y la consulta se responden en 10 días hábiles. El resto se tramita"
" como reclamo, en 15."

