#: .\apps\project\common\pqrs\views.py:202
msgid ""
"Too many requests from this connection. Try again later, or write to us "
"directly."
msgstr ""
"Demasiadas solicitudes desde esta conexión. Inténtalo más tarde, o "
"escríbenos directamente."

#: .\apps\project\common\pqrs\views.py:269
#, python-format
msgid "We received your request %(radicado)s"
msgstr "Recibimos tu solicitud %(radicado)s"

#: .\apps\project\common\pqrs\views.py:273
#, python-format
msgid ""
"We received your request.\n"
"\n"
"Reference: %(radicado)s\n"
"Type: %(kind)s\n"
"Received on: %(received)s\n"
"We will answer by: %(due)s\n"
"\n"
"Quote the reference if you need to ask about it.\n"
msgstr ""
"Recibimos tu solicitud.\n"
"\n"
"Radicado: %(radicado)s\n"
"Tipo: %(kind)s\n"
"Fecha de radicación: %(received)s\n"
"Te responderemos antes del: %(due)s\n"
"\n"
"Cita el radicado si necesitas preguntar por ella.\n"

#: .\apps\project\common\pqrs\views.py:309
#, python-format
msgid "New PQRS: %(radicado)s"
msgstr "Nueva PQRS: %(radicado)s"

#: .\apps\project\common\pqrs\views.py:312
#, python-format
msgid ""
"%(kind)s from %(name)s.\n"
"Due by %(due)s.\n"
msgstr ""
"%(kind)s de %(name)s.\n"
"Vence el %(due)s.\n"
