#: emails.py:27
msgid ""
"Sign in to Propensiones (GEA): here is the 6-digit verification code you "
"requested"
msgstr ""
"Inicio de sesión en Propensiones (GEA): aquí tienes el código de "
"verificación de 6 dígitos que has solicitado"

#: emails.py:30
msgid "Use the following code to sign in to your account."
msgstr "Utiliza el siguiente código para iniciar sesión en tu cuenta."

#: forms/buyers_register_form.py:26 forms/buyers_register_form.py:30
#: forms/suppliers_register_form.py:17 forms/suppliers_register_form.py:21
msgid "Email"
msgstr "Correo"

#: forms/buyers_register_form.py:36 forms/buyers_register_form.py:40
#: forms/suppliers_register_form.py:27 forms/suppliers_register_form.py:31
msgid "Confirm Email"
msgstr "Confirmar correo"

#: forms/buyers_register_form.py:49
msgid "Email domain is not allowed for buyer registration."
msgstr ""
"El dominio del correo no está permitido para el registro de compradores."

#: forms/buyers_register_form.py:60 forms/suppliers_register_form.py:47
msgid "Emails do not match."
msgstr "Los correos no coinciden."

#: forms/change_password_form.py:9
msgid "Current Password"
msgstr "Contraseña actual"

#: forms/change_password_form.py:13
msgid "Enter your current password"
msgstr "Introduce tu contraseña actual"

#: forms/change_password_form.py:22 forms/forgot_password_form.py:78
msgid "New Password"
msgstr "Contraseña nueva"

#: forms/change_password_form.py:26 forms/forgot_password_form.py:58
msgid "Enter new password"
msgstr "Introduce la contraseña nueva"

#: forms/change_password_form.py:35 forms/forgot_password_form.py:79
msgid "Confirm New Password"
msgstr "Confirmar contraseña nueva"

#: forms/change_password_form.py:39 forms/forgot_password_form.py:65
#: forms/forgot_password_form.py:69
msgid "Confirm new password"
msgstr "Confirma la contraseña nueva"

#: forms/change_password_form.py:55
msgid "Your current password was entered incorrectly."
msgstr "La contraseña actual que introdujiste no es correcta."

#: forms/change_password_form.py:71
msgid "The two password fields didn't match."
msgstr "Las dos contraseñas no coinciden."

#: forms/change_password_form.py:77
msgid "New password cannot be the same as current password."
msgstr "La contraseña nueva no puede ser igual a la actual."

#: forms/common_register_form.py:56 forms/common_register_form.py:61
msgid "Username"
msgstr "Usuario"

#: forms/common_register_form.py:67 forms/common_register_form.py:72
msgid "Names"
msgstr "Nombres"

#: forms/common_register_form.py:78
msgid "Surnames"
msgstr "Apellidos"

#: forms/common_register_form.py:83
msgid "Last names"
msgstr "Apellidos"

#: forms/common_register_form.py:89
msgid "User type"
msgstr "Tipo de usuario"

#: forms/common_register_form.py:98
msgid "Referred by"
msgstr "Referido por"

#: forms/common_register_form.py:112 forms/common_register_form.py:116
#: views.py:77
msgid "Password"
msgstr "Contraseña"

#: forms/common_register_form.py:122 forms/common_register_form.py:126
msgid "Confirm Password"
msgstr "Confirmar contraseña"

#: forms/common_register_form.py:136
msgid "Passwords do not match."
msgstr "Las contraseñas no coinciden."

#: forms/common_register_form.py:146
msgid "Code"
msgstr "Código"

#: forms/common_register_form.py:156
msgid "Cell phone"
msgstr "Celular"

#: forms/common_register_form.py:163
msgid "Cellphone"
msgstr "Celular"

#: forms/common_register_form.py:178
msgid "Enter a valid phone number (7–15 digits)."
msgstr "Introduzca un número de teléfono válido (7–15 dígitos)."

#: forms/common_register_form.py:198
msgid ""
"I have read and accept the terms and the personal data processing policy"
msgstr ""
"He leído y acepto los términos y la política de tratamiento de datos "
"personales"

#: forms/common_register_form.py:202
msgid ""
"The personal data processing policy has to be accepted in order to create "
"the account."
msgstr ""
"Hay que aceptar la política de tratamiento de datos personales para poder "
"crear la cuenta."

#: forms/common_register_form.py:212
msgid "Unique code"
msgstr "Código único"

#: forms/common_register_form.py:217
msgid "Unique Code"
msgstr "Código Único "

#: forms/forgot_password_form.py:18
msgid "Email or Username"
msgstr "Correo o usuario"

#: forms/forgot_password_form.py:23
msgid "Enter your email or username"
msgstr "Introduce tu correo o tu usuario"

#: forms/forgot_password_form.py:34
msgid "This field is required."
msgstr "Este campo es obligatorio."

#: forms/forgot_password_form.py:54
msgid "New password"
msgstr "Contraseña nueva"

#: forms/login_otp_form.py:30
msgid "Username or Email"
msgstr "Usuario o correo electrónico"

#: forms/login_otp_form.py:41 views.py:79 views.py:99
msgid "Verification code"
msgstr "Código de verificación"

#: forms/login_otp_form.py:87
msgid "Too many failed attempts. Please wait before trying again."
msgstr ""
"Demasiados intentos fallidos. Espera un momento antes de volver a "
"intentarlo."

#: forms/login_otp_form.py:101
msgid "The code is not valid or has expired. Request a new one."
msgstr "El código no es válido o ha caducado. Solicita uno nuevo."

#: login_view.py:404
msgid "Sign in with a code"
msgstr "Entrar con un código"

#: login_view.py:405
msgid "We send a six-digit code to the email on your account."
msgstr "Enviamos un código de seis dígitos al correo de tu cuenta."

#: login_view.py:410
msgid "Two-step verification"
msgstr "Verificación en dos pasos"

#: login_view.py:411
msgid "Enter the code from your authentication app."
msgstr "Escribe el código de tu aplicación de autenticación."

#: login_view.py:416
msgid "Backup token"
msgstr "Código de respaldo"

#: login_view.py:417
msgid ""
"Enter one of the backup tokens you saved when you set up two-step "
"verification."
msgstr ""
"Escribe uno de los códigos de respaldo que guardaste al configurar la "
"verificación en dos pasos."

#: login_view.py:421
msgid "Sign in"
msgstr "Iniciar sesión"

#: login_view.py:421
msgid "Enter your credentials to access GEA."
msgstr "Escribe tus credenciales para entrar en GEA."

#: login_view.py:606
msgid ""
"Your sign-in could not be completed because the session was lost. Please "
"sign in again."
msgstr ""
"No se pudo completar el acceso porque se perdió la sesión. Vuelve a entrar, "
"por favor."

#: views.py:76 views.py:87
msgid "Your details"
msgstr "Tus datos"

#: views.py:78
msgid "Contact"
msgstr "Contacto"

#: views.py:88
msgid "Tell us who you are and what kind of account you need."
msgstr "Dinos quién eres y qué tipo de cuenta necesitas."

#: views.py:91
msgid "Choose a password"
msgstr "Elige una contraseña"

#: views.py:92
msgid "It protects your assets and your orders: make it a long one."
msgstr "Protege tus activos y tus órdenes: que sea larga."

#: views.py:95
msgid "How we reach you"
msgstr "Cómo te contactamos"

#: views.py:96
msgid "We will use this email for your account and its notices."
msgstr "Usaremos este correo para tu cuenta y sus avisos."

#: views.py:100
msgid "The last step: the code that confirms the account is yours."
msgstr "El último paso: el código que confirma que la cuenta es tuya."

#: views.py:119
msgid "Register"
msgstr "Registrarse"

#: views.py:135
msgid "Create your account"
msgstr "Crea tu cuenta"

#: views.py:209
msgid "Invalid email."
msgstr "Correo electrónico no válido."

#: views.py:213
msgid "Too many code requests. Please try again later."
msgstr "Demasiadas solicitudes de código. Inténtalo más tarde."

#: views.py:222
msgid "Your GEA registration code"
msgstr "Tu código de registro en GEA"

#: views.py:224
#, python-format
msgid ""
"Your registration code is:\n"
"\n"
"%(code)s\n"
"\n"
"This code expires in %(minutes)s minutes."
msgstr ""
"Tu código de registro es:\n"
"\n"
"%(code)s\n"
"\n"
"Este código caduca en %(minutes)s minutos."

#: views.py:252
msgid "We sent a verification code to your email."
msgstr "Hemos enviado un código de verificación a tu correo."

#: views.py:292
msgid "Invalid or expired code."
msgstr "Código no válido o caducado."

#: views.py:336
msgid "A user with this email already exists."
msgstr "Ya existe un usuario con este correo electrónico."

#: views.py:343
msgid "A user with this username already exists."
msgstr "Ya existe un usuario con ese nombre de usuario."

#: views.py:460 views.py:550
msgid "Reset Your Password"
msgstr "Restablece tu contraseña"

#: views.py:520
msgid ""
"If an account exists with the provided email/username, you will receive "
"password reset instructions shortly."
msgstr ""
"Si existe una cuenta con el correo o el usuario indicados, recibirás en "
"breve las instrucciones para restablecer la contraseña."

#: views.py:526
msgid "Check Your Email"
msgstr "Revisa tu correo"

#: views.py:528
msgid ""
"We've sent password reset instructions to your email. Please check your "
"inbox and follow the link to reset your password."
msgstr ""
"Hemos enviado a tu correo las instrucciones para restablecer la contraseña. "
"Revisa tu bandeja de entrada y sigue el enlace para restablecerla."

#: views.py:568 views.py:615
msgid "Set New Password"
msgstr "Establece una contraseña nueva"

#: views.py:573 views.py:588
msgid ""
"The password reset link is invalid or has expired. Please request a new "
"password reset."
msgstr ""
"El enlace para restablecer la contraseña no es válido o ha caducado. "
"Solicita uno nuevo."

#: views.py:602
msgid ""
"Your password has been reset successfully. You can now log in with your new "
"password."
msgstr ""
"Tu contraseña se ha restablecido correctamente. Ya puedes iniciar sesión con"
" la contraseña nueva."

#: views.py:658
#, python-format
msgid "Password Reset Request for %(site)s"
msgstr "Solicitud de restablecimiento de contraseña para %(site)s"

#: views.py:692
msgid "You must be logged in to change your password."
msgstr "Tienes que haber iniciado sesión para cambiar tu contraseña."

#: views.py:710
msgid "Your password has been changed successfully!"
msgstr "¡Tu contraseña se ha cambiado correctamente!"

#: views.py:723
msgid "Change Password"
msgstr "Cambiar contraseña"
