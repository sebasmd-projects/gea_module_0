#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:118
msgid "Search by title or code…"
msgstr "Buscar por título o código…"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:119
msgid "No certified document matches."
msgstr "Ningún documento certificado coincide."

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:120
