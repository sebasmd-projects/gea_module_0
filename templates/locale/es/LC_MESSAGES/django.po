msgstr "Utiliza el siguiente código para iniciar sesión en tu cuenta."

#: templates/two_factor/core/login.html templates/email/login_otp_email.html
msgid "This code expires in %(tiempo)s minutes."
msgstr "Este código caduca en %(tiempo)s minutos."

#: templates/two_factor/core/login.html templates/email/login_otp_email.html
msgid "Did not request this code? Get in touch with us."
msgstr "¿No has solicitado este código? Ponte en contacto con nosotros."

#: templates/two_factor/core/login.html templates/email/login_otp_email.html
msgid "This is an automated message. <strong>Nobody from the firm will ever ask you\n            for this code</strong> by phone, WhatsApp or email."
msgstr "Este mensaje es automático. <strong>Nadie del despacho te pedirá este código</strong>\n            por teléfono, por WhatsApp ni por correo."
