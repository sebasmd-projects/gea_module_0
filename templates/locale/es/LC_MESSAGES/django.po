#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:51
msgid "Anchor URL (inside the QR)"
msgstr "URL del anclaje (dentro del QR)"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:55
msgid ""
"The QR carries this URL, not the proof: the page updates on its own as "
"anchors mature, so the PDF is never reissued."
msgstr ""
"El QR lleva esta URL, no la prueba: la página se actualiza sola según "
"maduran los anclajes, así que el PDF no se reemite nunca."

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:69
msgid "Save members"
msgstr "Guardar miembros"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:74
msgid ""
"Only certified documents can join: an uncertified one has no fingerprint to "
"include. Changing the members invalidates the seal."
msgstr ""
"Solo pueden entrar documentos certificados: uno sin certificar no tiene "
"huella que incluir. Cambiar los miembros invalida el sello."

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:82
msgid "Document"
msgstr "Documento"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:110
