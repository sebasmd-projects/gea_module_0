msgstr "PDF certificado (el que hace fe)"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:236
msgid "Public copy (watermarked)"
msgstr "Copia pública (con marca de agua)"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:240
msgid "Public verification page"
msgstr "Página pública de verificación"

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:245
msgid ""
"Uses the PDF and the layout chosen on the right. Reissuing keeps the "
"original already stored and redoes the stamping, the fingerprints and the "
"public copy."
msgstr ""
"Usa el PDF y la disposición elegidos a la derecha. Reemitir conserva el "
"original ya guardado y rehace el estampado, las huellas y la copia pública."

#: .\templates\dashboard\pages\documents\code_gen\summary_composer.html:256
