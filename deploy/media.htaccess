# deploy/media.htaccess  ->  copiar a MEDIA_ROOT/.htaccess
#
# MEDIA_ROOT vive dentro del arbol que sirve el servidor web, porque las
# imagenes de activos y la galeria tienen que servirse directas (rapido, sin
# pasar por Django). Lo que NO puede servirse directo es lo sensible.
#
# Bloquea:
#   certificates/      los tres PDF de cada certificacion y las fotos
#   passport_images/   documentos de identidad (PII)
#   signature_images/  firmas manuscritas (PII)
#   pqrs/              cedulas y certificados que adjunta quien radica un PQRS
#
# Todo eso se entrega por vistas de Django que si comprueban permisos.
# El resto de media sigue sirviendose directo.
#
# Sobre `pqrs/`: se cayo de esta lista cuando se creo la app, y es el peor
# sitio donde olvidarlo. El formulario es publico y sin sesion, asi que
# cualquiera puede depositar ahi un documento de identidad; la ruta lleva el
# radicado, pero un radicado **no es un secreto**: viaja por correo, por
# WhatsApp y por captura de pantalla, y esta impreso en el propio acuse.
# `manage.py check_security` comprueba que no vuelva a faltar ninguno.

# --- Bloqueo por ruta, relativo a este directorio -------------------
# Se usa mod_rewrite y no RedirectMatch porque las reglas quedan relativas a
# MEDIA_ROOT: si el directorio cambia de sitio, siguen valiendo.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(certificates|passport_images|signature_images|pqrs)(/|$) - [R=404,L]
</IfModule>

# Respaldo por si mod_rewrite no estuviera activo.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/public/media/certificates/
    RedirectMatch 404 ^/public/media/passport_images/
    RedirectMatch 404 ^/public/media/signature_images/
    RedirectMatch 404 ^/public/media/pqrs/
</IfModule>

# --- Nada de lo subido se ejecuta nunca ----------------------------
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
