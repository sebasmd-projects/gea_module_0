# ---------------------------------------------------------------------------
# GEA — plantilla de configuración
#
#   cp docs/env.example .env
#
# Copiala a `.env` en la raiz del repositorio y rellenala. `.env` esta ignorado
# por git y NO debe subirse nunca.
#
# ⚠️ Las variables marcadas OBLIGATORIA no tienen valor por defecto: `settings.py`
#    las pasa directas a `int()` o a `.split(',')`. Si falta una, el proyecto no
#    arranca. El error las nombra todas de una vez (`app_core/env.py`), pero
#    sale antes de arrancar nada: es mas rapido rellenarlas aqui.
#
#    Una variable VACIA cuenta como ausente, salvo donde vacio significa algo:
#    CORS_ALLOWED_ORIGINS (ningun origen), COMMON_ATTACK_TERMS (trampa
#    desactivada) y las dos contrasenas.
#
# Los valores de aqui son EJEMPLOS. Ninguno es un secreto real.
# ---------------------------------------------------------------------------


# === Django ================================================================

# OBLIGATORIA. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# OBLIGATORIA. 'True' solo en local. En el servidor, 'False'.
DJANGO_DEBUG=True

# OBLIGATORIA. Separados por comas, sin espacios.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OBLIGATORIA. Donde cuelga el panel. Ya NO es el control de acceso --eso lo
# hace la sesion con segundo factor-- pero sigue sin escribirse en el codigo.
DJANGO_ADMIN_URL=panel-dev

# OBLIGATORIAS. Rutas y prefijos de estaticos y media.
DJANGO_STATIC_URL=/public/static/
DJANGO_STATIC_ROOT=public/static
DJANGO_MEDIA_URL=/public/media/
DJANGO_MEDIA_ROOT=public/media

# OBLIGATORIA. Fichero de log. Se rota solo al pasar de 3 MB (`rotate_logs`).
DJANGO_LOG_FILE=logs/stderr.log


# === Base de datos =========================================================

# OBLIGATORIA. La RUTA COMPLETA del backend, no un nombre corto:
#   django.db.backends.mysql
#   django.db.backends.postgresql
DB_ENGINE=django.db.backends.mysql

# OBLIGATORIAS.
DB_NAME=gea
DB_USER=gea
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Opcionales.
DB_CONN_MAX_AGE=60
DB_CHARSET=utf8mb4
# Solo PostgreSQL, y solo se aplica con DEBUG=False: disable|allow|prefer|require
DB_SSLMODE=prefer


# === Correo ================================================================
# OBLIGATORIAS todas. En local, para no mandar nada de verdad:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.ejemplo.com
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_USE_SSL=True
DJANGO_EMAIL_HOST_USER=no-reply@ejemplo.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_DEFAULT_FROM_EMAIL=GEA <no-reply@ejemplo.com>


# === Seguridad =============================================================

# OBLIGATORIA. Cifra la PII en la base de datos. Generala con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# NO uses `manage.py generate_encryption_key` para la primera: ese comando no
# arranca si la variable esta vacia --los modelos importan encrypted_model_fields,
# que exige una clave valida al importarse-- y muere con ImproperlyConfigured.
# Sirve para ROTARLA despues, que es otra cosa.
#
# ⚠️ PERDERLA INUTILIZA TODOS LOS DATOS CIFRADOS. No se rota sin migrarlos.
#    Guarda una copia fuera del servidor antes de poner nada en produccion.
FIELD_ENCRYPTION_KEY=

# Con la que se cifran los respaldos que llevan PII.
# Sin ella, `db_backup` NO los escribe: `dumpdata` serializa el valor ya
# descifrado, asi que un volcado sin cifrar deshacia el cifrado de campo.
GEA_BACKUP_PASSPHRASE=

# Ed25519 en base64; firma el registro de certificacion. Generala con:
#   uv run python manage.py generate_certification_key
# Sin ella el registro se sella con HMAC y solo esta plataforma puede
# verificarlo: un tercero, no.
CERTIFICATION_SIGNING_KEY=

# Autoridad de sellado de tiempo RFC 3161 (opcional).
CERTIFICATION_TSA_URL=
CERTIFICATION_TSA_USERNAME=
CERTIFICATION_TSA_PASSWORD=

# Con que se resuelve la HORA de un bloque de Bitcoin. Una prueba de
# OpenTimestamps acredita una ALTURA, no una fecha; la fecha esta en la
# cabecera de ese bloque y hay que ir a pedirla.
#
# Van dos, de operadores distintos, y TIENEN QUE COINCIDIR para que la fecha se
# guarde: la pagina de anclaje dice «un tercero acredito la fecha, no es esta
# plataforma diciendolo», y una fecha de un solo explorador si es esta
# plataforma diciendolo, con un intermediario. Si discrepan no se guarda nada y
# queda en el log.
#
# Se consulta SOLO desde el cron `upgrade_ots_anchors`, nunca al pintar una
# pagina: con ATOMIC_REQUESTS eso seria una transaccion abierta esperando a un
# tercero. Opcionales las dos: sin ellas se usan los valores de abajo.
BITCOIN_BLOCK_EXPLORERS=https://mempool.space/api,https://blockstream.info/api

# A donde lleva el enlace del bloque en la pagina. Solo es un enlace para que
# quien lea pueda mirarlo en la cadena; la fecha no sale de aqui.
BITCOIN_BLOCK_EXPLORER_URL=https://mempool.space/block

# Base canonica del QR y del registro de certificacion.
# NUNCA se deriva del host de la peticion: el QR vive dentro del PDF y no puede
# apuntar al servidor desde el que se certifico.
PUBLIC_BASE_URL=http://localhost:8000

# OBLIGATORIA. Separados por comas. Vacio es valido.
CORS_ALLOWED_ORIGINS=

# OBLIGATORIA. Terminos de la trampa anti-escaneo, separados por comas.
# ⚠️ Cada termino es una ruta legitima menos: se emparejan como SEGMENTO, y ya
#    hubo un autobloqueo por meter `env` cuando el emparejado era por
#    subcadena (convertia /envio/ en trampa). Hoy `env` esta otra vez en la
#    lista a proposito: con el emparejado por segmento completo ya no pasa
#    --`/envio/` no cae, solo un segmento que sea exactamente `env`-- pero
#    sigue siendo el ejemplo de por que cada termino nuevo se verifica y no
#    se da por bueno a ojo.
#    Tras tocarla: uv run python manage.py check_attack_terms
# `claude` y `codex` cubren el escaneo de credenciales de herramientas de IA
# (`.claude/credentials.json`, `.codex/auth.json` y variantes con prefijo
# `/backup/`, `/app/`, `/.config/`...): el termino sin punto ya cubre la
# forma con punto (`.claude`, `.codex`) y la forma sin el (`claude/`,
# `codex/`, como en `/.config/codex/auth.json`), porque el punto inicial de
# la trampa es opcional.
# `setup` aparece en la lista y tambien es la ruta real de
# `two_factor:setup` (`/account/two_factor/setup/`) -- no es una colision:
# `two_factor.urls` se registra antes que la trampa en `app_core/urls.py`,
# asi que esa ruta resuelve primero. `check_attack_terms` lo confirma
# recorriendo el URLconf en orden, no solo comparando el patron.
COMMON_ATTACK_TERMS=setup,env,phpmyadmin,php,wordpress,wp,wp-admin,wp-login,wp-content,wp-includes,xmlrpc.php,about.php,admin.php,administrator,dbadmin,sql,backup,bak,config,configuration,conf,conf.php,config.php,config.inc.php,install.php,install,index.php,index,test.php,test,phpinfo.php,phpinfo,pma,pma/index.php,pma/scripts/setup.php,pma/scripts/setup,pma/setup.php,pma/setup,myadmin,myadmin/index.php,myadmin/scripts/setup.php,myadmin/scripts/setup,myadmin/setup.php,claude,codex

# OBLIGATORIA. Minutos del primer bloqueo por IP; se duplica en cada intento
# hasta un tope de 24 h.
IP_BLOCKED_TIME_IN_MINUTES=15

# OBLIGATORIA aunque no la lea nadie (se declara y no se consume).
MIDDLEWARE_NOT_INCLUDE=

# Opcionales, con sus valores por defecto.
AXES_FAILURE_LIMIT=6          # bloqueo por pareja (IP, usuario)
AXES_COOLOFF_MINUTES=30       # nunca dejarlo sin espera
LOGIN_OTP_TTL_MINUTES=15      # cuanto dura el codigo de acceso
OTP_TTL_MINUTES=15            # el de la verificacion documental
OTP_CONTACT_EMAIL=info@propensionesabogados.com
SCAN_404_THRESHOLD=20         # cuantos 404 en la ventana
SCAN_404_WINDOW_SECONDS=300   # la ventana del detector
GEOIP_PATH=                   # sin ella, el pais de un bloqueo queda vacio

# Credencial de Safety CLI. SOLO en local, para `check_security` §9: en el
# servidor esa seccion ni se intenta (alli la de dependencias es pip-audit, que
# no lleva clave). NUNCA se pasa como --key.
SAFETY_API_KEY=


# === Cache y cola ==========================================================
# Ver deploy/REDIS.md para montarlo con TLS y ACL.
#
# ⚠️ Sin REDIS_URL, Django cae en LocMemCache, que es POR PROCESO: los limites
#    de intentos pasan a ser por worker, o sea el limite configurado
#    multiplicado por el numero de procesos. En local da igual; en produccion no.

REDIS_URL=
REDIS_KEY_PREFIX=gea
REDIS_CONNECT_TIMEOUT=3
REDIS_TIMEOUT=3

# Vacia mientras no haya cola de tareas. NO es REDIS_URL: el broker lleva su
# propio usuario y su propia base (deploy/REDIS.md §9), porque el de la cache
# esta acotado a ~gea:* y responde NOPERM a las operaciones de un broker.
CELERY_BROKER_URL=


# === Negocio e integraciones ===============================================

# OBLIGATORIAS. Separadas por comas. A quien se manda el codigo diario.
GEA_DAILY_CODE_GENERAL_RECIPIENTS=
GEA_DAILY_CODE_BUYER_RECIPIENTS=

# OBLIGATORIA. Separadas por comas. A quien avisa una PQRS nueva.
PQRS_NOTIFICATION_RECIPIENTS=

# OBLIGATORIA (puede ir vacia). Sin ella la traduccion automatica NO falla:
# devuelve el texto original. En DEBUG tampoco sale a la red.
CHAT_GPT_API_KEY=

# Solo para el script de transcripcion.
OA_AUDIO_MODEL=gpt-4o-transcribe
OA_TEXT_MODEL=gpt-4o-mini

# La URL que golpea la tarea de calentamiento cada 3 minutos.
GEA_WARMUP_URL=http://localhost:8000/health/
